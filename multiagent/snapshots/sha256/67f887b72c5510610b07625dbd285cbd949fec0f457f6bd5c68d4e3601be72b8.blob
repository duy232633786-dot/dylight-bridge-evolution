  "geometry_conventions": {
    "axes": "y ngang (dương phải), z đứng (dương lên), mặt đỉnh z = 0, đối xứng qua y = 0; đơn vị m",
    "depth": "H = HO1 + HO2 + HO3. Lỗ: bản trên theo HI1 (từ đỉnh) và vút HI2; bản đáy theo HI5 (từ đáy) và vút HI4; băng sườn hiệu dụng = H − HI1 − HI2 − HI4 − HI5. MIDAS không bắt buộc HI1+…+HI5 = H (ví dụ manual lệch 0,03 m); lệch với HI3 nhập chỉ là cảnh báo (consistency_warnings), chặn khi băng sườn ≤ 0",
    "widths": "nửa bề rộng đỉnh = BO1 + BO2 + BO3; nửa bề rộng đáy = BO3; BO2 = độ chạy ngang của sườn ngoài",
    "outer_sub_dims": "BO1-1 (JO1), BO1-2 (JO2) đo từ MÚT cánh hẫng; HO2-1, HO2-2 đo từ mức đáy mút cánh (sau HO1) xuống; JO3: BO2-1 đo từ góc đáy ngoài ra phía cánh, HO3-1 đo từ đáy lên",
    "inner_sub_dims": "BI1-1 (JI1), BI1-2 (JI2), BI2-1 (JI3), BI3-1 (JI5), BI3-2 (JI4) đo từ TIM; HI2-1/HI2-2 đo từ mặt trong bản trên (mức HI1) xuống; HI3-1 đo từ góc trên lỗ xuống; HI4-1 (JI5), HI4-2 (JI4) đo từ mặt trong bản đáy lên",
    "joint_order_around_void": "JI1 (bản trên, gần tim) → JI2 (bản trên, gần sườn) → JI3 (sườn) → JI4 (bản đáy, gần sườn) → JI5 (bản đáy, gần tim)",
    "two_cell_assumption": "2CELL: BI4 = nửa dày sườn giữa; hai lỗ đối xứng, khớp chỉ ở sườn ngoài — GIẢ ĐỊNH, chưa đối chiếu hình guide 2CELL",
    "shear_positions": "Z đo từ thớ đáy như MIDAS hiển thị; Z1 = mức góc trên lỗ, Z2 = tâm, Z3 = mức góc đáy lỗ (lab ước lượng; MIDAS Auto có thể lấy hơi khác)",
    "exports_hi3": "Mọi khối xuất (dialog, TSV, JSON, MCT) dùng HI3 hiệu dụng = H − HI1 − HI2 − HI4 − HI5 để tham số MIDAS, đa giác lab và đặc trưng LAB_CROSS_CHECK cùng mô tả một tiết diện; HI3 gõ khác đi được giữ trong params.dims và báo hi3_adjusted"
  },
