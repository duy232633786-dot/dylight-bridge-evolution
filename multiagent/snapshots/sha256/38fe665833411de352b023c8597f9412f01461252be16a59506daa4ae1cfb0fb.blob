{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local_document_index.schema.json",
  "title": "LocalDocumentIndex",
  "description": "Chỉ mục CHỈ-ĐỌC các tài liệu kỹ thuật trên ổ đĩa nội bộ. Chỉ ghi ĐƯỜNG DẪN + SIÊU DỮ LIỆU; không copy nội dung, không nhân bản file, và tuyệt đối không chứa số liệu kỹ thuật suy từ tên file (tiết diện, chiều cao dầm, mô men quán tính...). Phạm vi do chủ dự án chốt: PDF, bản vẽ DWG/DXF, Excel, và tiêu chuẩn (tách riêng thành category STANDARD). Mọi định dạng khác (.rvt, .rfa, .doc, .docx, ảnh, video, mã nguồn) nằm ngoài phạm vi và không được xuất hiện ở đây.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "scan_started_utc",
    "scan_finished_utc",
    "roots",
    "extensions_included",
    "counts",
    "documents",
    "skipped",
    "unreadable"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "tool_version": { "type": "string", "minLength": 1 },
    "scan_started_utc": { "$ref": "#/$defs/utcTimestamp" },
    "scan_finished_utc": { "$ref": "#/$defs/utcTimestamp" },
    "roots": {
      "description": "Các gốc quét, ghi nguyên văn như người dùng truyền vào.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "extensions_included": {
      "description": "Danh sách đuôi file được nhận. Không đuôi nào ngoài enum này được lập chỉ mục.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/extension" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "scanned_files",
        "by_extension",
        "by_category",
        "by_relevance",
        "by_drive"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "scanned_files": {
          "description": "Tổng số file đã duyệt qua (kể cả file ngoài phạm vi bị bỏ im lặng).",
          "type": "integer",
          "minimum": 0
        },
        "by_extension": { "$ref": "#/$defs/countMap" },
        "by_category": { "$ref": "#/$defs/countMap" },
        "by_relevance": { "$ref": "#/$defs/countMap" },
        "by_drive": { "$ref": "#/$defs/countMap" }
      }
    },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/document" }
    },
    "skipped": {
      "description": "File thuộc phạm vi đuôi nhưng bị loại khỏi chỉ mục chính, kèm lý do đếm được.",
      "type": "array",
      "items": { "$ref": "#/$defs/pathReason" }
    },
    "unreadable": {
      "description": "File/thư mục không đọc được (quyền truy cập, đang bị khóa, bảo vệ mật khẩu). Không tìm cách phá.",
      "type": "array",
      "items": { "$ref": "#/$defs/pathReason" }
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "extension": {
      "enum": ["pdf", "dwg", "dxf", "xlsx", "xls", "xlsm"]
    },
    "countMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "pathReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "path",
        "drive",
        "filename",
        "extension",
        "size_bytes",
        "sha256",
        "sha256_is_partial",
        "modified_utc",
        "category",
        "relevance",
        "reason",
        "runtime_link",
        "already_in_vault",
        "notes"
      ],
      "properties": {
        "document_id": { "type": "string", "pattern": "^DOC-[0-9]{5}$" },
        "path": { "type": "string", "minLength": 1 },
        "drive": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "extension": { "$ref": "#/$defs/extension" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sha256_is_partial": {
          "description": "true = sha256 chỉ tính trên phần đầu file + kích thước, KHÔNG phải hash toàn bộ nội dung.",
          "type": "boolean"
        },
        "modified_utc": { "$ref": "#/$defs/utcTimestamp" },
        "category": {
          "enum": [
            "STANDARD",
            "DRAWING",
            "SPREADSHEET",
            "REPORT_PDF",
            "COURSE_MATERIAL",
            "SOFTWARE_MANUAL",
            "UNKNOWN"
          ]
        },
        "relevance": { "enum": ["DIRECT", "ADJACENT", "UNRELATED"] },
        "reason": {
          "description": "Vì sao gán mức liên quan này — chỉ nêu từ khóa khớp trong tên/đường dẫn, không suy diễn kỹ thuật.",
          "type": "string",
          "minLength": 1
        },
        "runtime_link": {
          "description": "GỢI Ý liên kết tới rule/biến/catalog trong repo. CHƯA CÓ NGƯỜI XÁC NHẬN — không được dùng làm căn cứ tính toán.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "already_in_vault": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "if": {
        "properties": { "sha256_is_partial": { "const": true } },
        "required": ["sha256_is_partial"]
      },
      "then": {
        "required": ["notes"],
        "properties": { "notes": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
