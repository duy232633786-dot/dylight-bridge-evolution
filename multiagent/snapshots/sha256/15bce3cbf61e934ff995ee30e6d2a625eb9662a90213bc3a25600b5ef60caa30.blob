{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frame_f1_model.schema.json",
  "title": "FrameF1LinearElastic2DModel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "analysis_type",
    "units",
    "nodes",
    "materials",
    "sections",
    "elements",
    "supports",
    "load_cases"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "model_id": { "type": "string", "pattern": "^F1M-[A-Za-z0-9._-]{1,64}$" },
    "analysis_type": { "const": "LINEAR_ELASTIC_2D_SMALL_DISPLACEMENT" },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "force", "moment", "elastic_modulus", "area", "inertia"],
      "properties": {
        "length": { "const": "m" },
        "force": { "const": "kN" },
        "moment": { "const": "kN_m" },
        "elastic_modulus": { "const": "GPa" },
        "area": { "const": "m2" },
        "inertia": { "const": "m4" }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/node" }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/material" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/element" }
    },
    "supports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/support" }
    },
    "load_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/load_case" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x_m", "y_m"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "x_m": { "type": "number" },
        "y_m": { "type": "number" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "elastic_modulus_GPa", "source_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "elastic_modulus_GPa": { "type": "number", "exclusiveMinimum": 0 },
        "source_ref": { "$ref": "#/$defs/source_ref" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "area_m2", "inertia_m4", "source_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "area_m2": { "type": "number", "exclusiveMinimum": 0 },
        "inertia_m4": { "type": "number", "exclusiveMinimum": 0 },
        "source_ref": { "$ref": "#/$defs/source_ref" }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "node_i", "node_j", "material_id", "section_id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["FRAME_2D", "TRUSS_2D"] },
        "node_i": { "$ref": "#/$defs/identifier" },
        "node_j": { "$ref": "#/$defs/identifier" },
        "material_id": { "$ref": "#/$defs/identifier" },
        "section_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "ux", "uy", "rz"],
      "properties": {
        "node_id": { "$ref": "#/$defs/identifier" },
        "ux": { "type": "boolean" },
        "uy": { "type": "boolean" },
        "rz": { "type": "boolean" }
      },
      "anyOf": [
        { "properties": { "ux": { "const": true } } },
        { "properties": { "uy": { "const": true } } },
        { "properties": { "rz": { "const": true } } }
      ]
    },
    "nodal_load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "fx_kN", "fy_kN", "mz_kNm"],
      "properties": {
        "node_id": { "$ref": "#/$defs/identifier" },
        "fx_kN": { "type": "number" },
        "fy_kN": { "type": "number" },
        "mz_kNm": { "type": "number" }
      }
    },
    "load_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "combination_status", "source_ref", "nodal_loads"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "combination_status": {
          "enum": ["USER_SUPPLIED_UNFACTORED", "USER_SUPPLIED_FACTORED", "RESEARCH_BENCHMARK"]
        },
        "source_ref": { "$ref": "#/$defs/source_ref" },
        "nodal_loads": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nodal_load" }
        }
      }
    }
  }
}
