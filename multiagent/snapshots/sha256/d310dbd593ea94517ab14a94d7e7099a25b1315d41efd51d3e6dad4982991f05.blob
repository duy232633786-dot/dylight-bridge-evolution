  "falsification_criterion": {
    "statement_vi": "Họ kết cấu này bị BÁC BỎ nếu bất kỳ falsifier nào dưới đây đúng. Không falsifier nào đã được kiểm — toàn bộ status là NOT_TESTED, và đó chính là lý do claim_level dừng ở IDEA.",
    "family_rejected_if": "Đá tại một trong hai chân không nhận được lực xô H bằng đường lực CỨNG và NGẮN, hoặc chênh lệch chuyển vị ngang hai chân sinh mô men vượt khả năng của vành vòm.",
    "falsifiers": [
      {
        "id": "FALS-01",
        "statement_vi": "Khảo sát địa chất cho thấy có nêm đá hở ra vách ở một trong hai chân, hoặc đá không đủ CƯỜNG ĐỘ để nhận H.",
        "test_method": "Khảo sát theo gói dữ liệu LIT-068 (GEC 5) + phân tích trượt nêm đá.",
        "consequence_vi": "Toàn bộ họ 'truyền lực xô vào đá' sụp; phải chuyển sang thrust_restraint_system = TIED_ARCH_TIE_AT_SPRINGING_LEVEL, và khi đó mặt cầu/thanh căng đảo từ nén sang KÉO và toàn bộ phân tích hai chân phải làm lại.",
        "status": "NOT_TESTED"
      },
      {
        "id": "FALS-02",
        "statement_vi": "Đá đủ cường độ nhưng không đủ ĐỘ CỨNG: chênh lệch chuyển vị ngang giữa hai chân vòm sinh mô men vượt khả năng vành vòm.",
        "test_method": "Phân tích vòm với chuyển vị chân cưỡng bức lệch; ngưỡng cho phép phải suy ra TỪ mô men gây ra trong vành vòm.",
        "must_not_use_vi": "TUYỆT ĐỐI KHÔNG lấy Bảng 5-1 của LIT-070 (0,004 / 0,008 rad) — bảng đó hiệu chỉnh cho CẦU DẦM, nơi chuyển vị gối chỉ sinh hiệu ứng THỨ CẤP. Với vòm, chuyển vị chân tấn công thẳng vào cơ chế chịu lực CHÍNH. Áp con số đó vào đây là đúng loại lỗi false-precision mà dự án đang tránh.",
        "status": "NOT_TESTED"
      },
      {
        "id": "FALS-03",
        "statement_vi": "Không tồn tại một CHUỖI trạng thái thi công nào mà mọi bước trung gian đều đứng vững — kể cả khi trạng thái hoàn thiện đứng vững.",
        "test_method": "Phân tích chuỗi sơ đồ: mỗi giai đoạn trong construction_stage_id có sơ đồ riêng, TIẾT DIỆN riêng và tổ hợp tải riêng.",
        "why_vi": "LIT-054 đặt vấn đề rằng khi khẩu độ tăng, chính khiếm khuyết của HỆ THIẾT BỊ TẠM mới gây ra vấn đề hiệu quả–chi phí–an toàn. Trạng thái khống chế nằm ở BƯỚC TRUNG GIAN, không ở sơ đồ hoàn thiện.",
        "runtime_state": "ABSENT (STAGED_PRESTRESS_EFFECTS = ABSENT)",
        "status": "NOT_TESTED"
      },
      {
        "id": "FALS-04",
        "statement_vi": "Vành vòm mất ổn định NGOÀI MẶT PHẲNG dưới tổ hợp tải khống chế, ở bất kỳ giai đoạn nào.",
        "test_method": "Phân tích oằn (buckling) trong và ngoài mặt phẳng cho hệ vòm + giằng ngang; cần solver 3D — hiện ABSENT.",
        "status": "NOT_TESTED"
      },
      {
        "id": "FALS-05",
        "statement_vi": "Trạng thái consol có cáp treo trong thi công là trạng thái NHẠY GIÓ và không kiểm được.",
        "test_method": "Theo tiêu chí đề xuất trong LIT-089: chu kỳ dao động cơ bản > 1 giây, hoặc cầu dây, thì coi là nhạy gió. LIT-089 nêu nguyên văn rằng đã có báo cáo cầu dao động quá mức do gió TRONG THI CÔNG mà quy định hiện hành không nhận diện được.",
        "note_vi": "Lập luận bỏ qua gió mà dự án dùng cho dầm Super-T 38,3 m KHÔNG chuyển sang được cho họ này.",
        "status": "NOT_TESTED"
      },
      {
        "id": "FALS-06",
        "statement_vi": "Topo lưới giằng không quy về được MỘT mô đun khoang lặp lại, khiến mọi nút liên kết là hàng đặt riêng.",
        "test_method": "Kiểm hình học: bước khoang không đổi, tiết diện thanh giằng biến thiên ĐƠN ĐIỆU theo bao lực cắt của hoạt tải nửa nhịp.",
        "why_vi": "LIT-055 cho thấy với họ vòm CFST / vòm bê tông khung xương ống thép, thiết kế–chế tạo–lắp dựng ống thép là một công nghệ then chốt làm như MỘT thể thống nhất. Topo ngẫu nhiên triệt tiêu chính ưu thế đó khi khẩu độ tăng.",
        "status": "NOT_TESTED"
      },
      {
        "id": "FALS-07",
        "statement_vi": "Nút hàn của lưới giằng không đạt tuổi thọ mỏi, vì thanh chéo ĐẢO DẤU mỗi lần xe tải chạy qua.",
        "test_method": "TBD",
        "blocked_by_vi": "Trong 111 nguồn của research/literature/index.json KHÔNG có nguồn nào về mỏi chi tiết THÉP — cả nhóm FATIGUE_DURABILITY đều về bê tông, clorua, carbonat hoá. Hạng mục này để TBD tường minh; KHÔNG bịa nguồn mới, KHÔNG suy đoán.",
        "status": "NOT_TESTED"
      }
