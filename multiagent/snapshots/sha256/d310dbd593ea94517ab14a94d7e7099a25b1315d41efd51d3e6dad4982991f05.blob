  "load_path_hypothesis": {
    "state_labelled": "S7_SERVICE",
    "statement_vi": "Đây là GIẢ THUYẾT đường lực cho trạng thái khai thác đã hợp long, suy ra bằng cân bằng tĩnh học làm tay. Không dòng nào được tính bởi runtime.",
    "steps": [
      {
        "step": 1,
        "from": "Bánh xe / hoạt tải",
        "to": "Lớp phủ + bản mặt cầu",
        "action": "UON",
        "note_vi": "Uốn cục bộ của bản giữa các sườn/dầm mặt cầu. Bài toán bản mặt cầu thuộc phạm vi LIT-056 (TCVN 11823-9)."
      },
      {
        "step": 2,
        "from": "Bản mặt cầu",
        "to": "Dầm dọc / dầm ngang mặt cầu",
        "action": "UON",
        "note_vi": "Nhịp mặt cầu = bước khoang vòm, ngắn hơn hẳn nhịp Super-T mà runtime được hiệu chỉnh; tham số và ngưỡng FAB/GEOM của runtime KHÔNG chuyển thẳng sang được."
      },
      {
        "step": 3,
        "from": "Dầm mặt cầu",
        "to": "Đầu cột khoang vòm",
        "action": "NEN",
        "note_vi": "Phản lực đứng tập trung. Đây là chỗ tải trọng rời khỏi hệ uốn để vào hệ nén."
      },
      {
        "step": 4,
        "from": "Cột khoang vòm",
        "to": "Lưng vành vòm",
        "action": "NEN",
        "note_vi": "Nén dọc trục + uốn thứ cấp. Càng gần chân vòm cột càng ngắn, độ cứng ngang tăng theo bậc ~1/h^3 nên cột ngắn HÚT lực ngang không tương xứng — bài toán 'cột ngắn'. Vùng đó nên là tường khoang vòm đặc, không phải cột kéo dài."
      },
      {
        "step": 5,
        "from": "Vành vòm",
        "to": "Chân vòm",
        "action": "HON_HOP",
        "note_vi": "NÉN dọc trục là chủ đạo, nhưng UỐN không bằng 0: hoạt tải nửa nhịp, gradient nhiệt, co ngót–từ biến, co ngắn đàn hồi và mọi chuyển vị/nở ra của chân vòm đều sinh mô men. Trạng thái giới hạn thật là ỔN ĐỊNH (oằn trong và ngoài mặt phẳng), không phải cường độ nén."
      },
      {
        "step": 6,
        "from": "Chân vòm",
        "to": "Bệ chân vòm trên đá",
        "action": "NEN",
        "note_vi": "Hợp lực NGHIÊNG, tách thành phản lực đứng V và lực xô ngang H. Xem derivations.thrust_to_vertical_ratio: với vòm parabol chịu tải phân bố đều thì H/V = (L/f)/4, nên với mọi vòm thoải hơn L/f = 4 thì H > V."
      },
      {
        "step": 7,
        "from": "Bệ chân vòm",
        "to": "Khối đá (mố thiên nhiên)",
        "action": "HON_HOP",
        "note_vi": "Ép mặt (NÉN) + chống trượt (CẮT) + neo nếu cần. Dạng phá hoại khống chế là TRƯỢT NÊM ĐÁ theo mặt khe nứt hở ra vách — bài toán cơ học đá, KHÔNG phải bài toán bearing capacity."
      },
      {
        "step": 8,
        "from": "Khối đá",
        "to": "KẾT THÚC — đường lực khép kín",
        "action": "NEN",
        "note_vi": "Đường lực chỉ khép kín được ở KHỐI ĐÁ, không ở đâu khác. Đây là bộ phận chịu lực quan trọng nhất của toàn hệ dù không ai vẽ nó ra."
      }
    ],
