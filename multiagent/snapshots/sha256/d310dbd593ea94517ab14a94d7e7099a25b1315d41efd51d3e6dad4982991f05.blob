  "derivations": {
    "thrust_to_vertical_ratio": {
      "applies_to": "Vòm parabol khẩu độ L, đường tên f, chịu tải phân bố đều w trên toàn khẩu độ",
      "steps": [
        "Bước 1 — phản lực đứng mỗi chân: V = w·L/2",
        "Bước 2 — lực xô ngang: H = w·L^2/(8·f)",
        "Bước 3 — tỉ số: H/V = [w·L^2/(8f)] / [w·L/2] = L/(4f)"
      ],
      "table_L_over_f_to_H_over_V": {
        "2": 0.5,
        "3": 0.75,
        "4": 1.0,
        "5": 1.25,
        "6": 1.5,
        "8": 2.0,
        "10": 2.5
      },
      "conclusion_vi": "Với mọi vòm thoải hơn L/f = 4, lực xô ngang LỚN HƠN phản lực đứng. Muốn giữ chân vòm chỉ bằng ma sát trên mặt phẳng thì cần hệ số ma sát ≥ 1,0 — không đạt được với bê tông trên đá. Do đó bệ chân vòm BẮT BUỘC phải khoét/tỳ vào đá gốc theo mặt vuông góc hợp lực, hoặc neo dự ứng lực vào đá.",
      "scope_warning_vi": "Đây là mô hình tải phân bố đều lý tưởng. Vòm chạy trên thật nhận tải qua các cột khoang vòm (tải TẬP TRUNG), tĩnh tải phân bố không đều, và tải thi công hẫng khác hẳn tải khai thác. Con số H/V ở trên chỉ trả lời câu 'lực xô có cùng bậc độ lớn với phản lực đứng không' — câu trả lời là CÓ, thậm chí lớn hơn — chứ KHÔNG dùng để thiết kế.",
      "friction_and_bearing_values": "TBD — phải lấy từ khảo sát địa chất, LIT-074 (TCVN 11823-10) và LIT-066 (GEC 10)."
    }
  },
