# ---------------------------------------------------------------------------

TOPOLOGY_KEYS = [
    "arch_axis_type",
    "arch_rib_count",
    "springing_restraint",
    "spandrel_system",
    "thrust_restraint_system",
]


def _toy_candidates():
    return [
        {"candidate_id": "C-01", "descriptors": {"a": "X", "n": 0.0}, "l0_status": "PASS"},
        {"candidate_id": "C-02", "descriptors": {"a": "X", "n": 100.0}, "l0_status": "PASS"},
        {"candidate_id": "C-03", "descriptors": {"a": "Y", "n": 50.0}, "l0_status": "UNKNOWN_INPUT_MISSING"},
        {"candidate_id": "C-04", "descriptors": {"a": "Y", "n": 25.0}, "l0_status": "FAIL"},
        {"candidate_id": "C-05", "descriptors": {"a": "Z", "n": 75.0}, "l0_status": None},
    ]


def test_diversity_selection_is_deterministic_and_objective_free():
    kwargs = dict(categorical_keys=["a"], numeric_keys=["n"])
    first = select_diverse_top_set(_toy_candidates(), 3, **kwargs)
    second = select_diverse_top_set(_toy_candidates(), 3, **kwargs)
    assert first == second
    assert first["selected"][0] == "C-01"  # seed_index = 0, tất định
    assert first["claim_level"] == "IDEA"
    assert first["selection_is_objective_free"] is True
    assert first["statement_vi"].strip()


def test_diversity_excludes_l0_fail_and_flags_unknown():
    out = select_diverse_top_set(
        _toy_candidates(), 4, categorical_keys=["a"], numeric_keys=["n"])
    assert out["excluded_l0_fail"] == ["C-04"]
    assert "C-04" not in out["selected"]
    assert out["unknown_l0_included"] == ["C-03"]
    assert out["unscreened_l0_included"] == ["C-05"]
    assert out["min_pairwise_distance"] > 0.0


def test_diversity_coverage_quota_swaps_in_missing_value():
    cands = [
        {"candidate_id": "D-01", "descriptors": {"a": "X", "n": 0.0}, "l0_status": "PASS"},
        {"candidate_id": "D-02", "descriptors": {"a": "X", "n": 100.0}, "l0_status": "PASS"},
        {"candidate_id": "D-03", "descriptors": {"a": "X", "n": 50.0}, "l0_status": "PASS"},
        {"candidate_id": "D-04", "descriptors": {"a": "Y", "n": 0.0}, "l0_status": "PASS"},
    ]
    out = select_diverse_top_set(
        cands, 2, categorical_keys=["a"], numeric_keys=["n"], coverage_quota={"a": 2})
    assert {d["a"] for d in out["selected_descriptors"]} == {"X", "Y"}
    assert out["quota_unmet"] == []


def test_diversity_unmet_quota_is_reported_not_silent():
    cands = [
        {"candidate_id": "E-01", "descriptors": {"a": "X"}, "l0_status": "PASS"},
        {"candidate_id": "E-02", "descriptors": {"a": "X"}, "l0_status": "PASS"},
    ]
    out = select_diverse_top_set(cands, 2, categorical_keys=["a"], coverage_quota={"a": 2})
    assert out["quota_unmet"] and out["quota_unmet"][0]["key"] == "a"


def test_diversity_bad_inputs_raise():
    with pytest.raises(ShapeDiversityError):
        select_diverse_top_set(_toy_candidates(), 0, categorical_keys=["a"])
    with pytest.raises(ShapeDiversityError):
        # k lớn hơn số ứng viên hợp lệ (4 sau khi loại FAIL) — người gọi phải biết
        select_diverse_top_set(_toy_candidates(), 5, categorical_keys=["a"])
    with pytest.raises(ShapeDiversityError):
        # thiếu descriptor — không được đoán giá trị thay người gọi
        select_diverse_top_set(
            [{"candidate_id": "F-01", "descriptors": {}, "l0_status": None}],
            1, categorical_keys=["a"])
    with pytest.raises(ShapeDiversityError):
        # quota > k: không thể thoả theo nguyên lý ngăn kéo
        select_diverse_top_set(
            _toy_candidates(), 1, categorical_keys=["a"], coverage_quota={"a": 2})


def test_diversity_output_contains_no_forbidden_key():
    out = select_diverse_top_set(
        _toy_candidates(), 3, categorical_keys=["a"], numeric_keys=["n"])
    for path, key, _ in _walk(out):
        low = str(key).lower()
        assert low not in FORBIDDEN_VALUE_KEYS, f"{path}: {key}"
        assert low not in FORBIDDEN_BLOCK_KEYS, f"{path}: {key}"


def test_enumerated_hypotheses_are_reproducible_and_only_topology(grammar):
    hyps = enumerate_topology_hypotheses(grammar, TOPOLOGY_KEYS)
    assert len(hyps) == 2 * 2 * 3 * 3 * 3  # tích Descartes 5 miền hình thái
    ids = [h["candidate_id"] for h in hyps]
    assert len(ids) == len(set(ids))
    assert all(h["l0_status"] is None for h in hyps)
    assert hyps == enumerate_topology_hypotheses(grammar, TOPOLOGY_KEYS)  # tái lập
    first = hyps[0]
    canonical = json.dumps(
        first["descriptors"], sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    assert first["candidate_id"] == (
        "HYP-" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()[:16])
    with pytest.raises(ShapeDiversityError):
        # miền PLACEHOLDER_PENDING_DESIGN_BASIS không được liệt kê thành giả thuyết
        enumerate_topology_hypotheses(grammar, ["span_m"])


def test_top6_from_real_grammar_keeps_shape_diversity(grammar):
    hyps = enumerate_topology_hypotheses(grammar, TOPOLOGY_KEYS)
    out = select_diverse_top_set(
        hyps, 6, categorical_keys=TOPOLOGY_KEYS,
        coverage_quota={"arch_axis_type": 2, "spandrel_system": 2})
    assert len(out["selected"]) == 6
    assert len({d["arch_axis_type"] for d in out["selected_descriptors"]}) >= 2
    assert len({d["spandrel_system"] for d in out["selected_descriptors"]}) >= 2
    assert out["quota_unmet"] == []
    assert out["claim_level"] == "IDEA"


# ---------------------------------------------------------------------------
# 13. pre_registration.json — artifact bắt buộc của BRD-004
# ---------------------------------------------------------------------------

@pytest.fixture(scope="module")
def prereg():
    return _load_json(PREREG_PATH)


def test_pre_registration_required_fields_locked_and_idea(prereg):
    assert prereg["schema_version"] == "1.0"
    assert prereg["preregistration_id"] == "SHAPE-DISCOVERY-ARCH-DECK-V1"
    assert prereg["task_id"] == "BRD-004"
    assert prereg["locked_before_running"] is True
    assert prereg["claim_ceiling"] == "IDEA"
    for field in (
        "title", "created_at_utc", "claim_ceiling_note", "research_question",
        "hypotheses", "l0_screening_protocol", "diversity_selection_rule",
        "primary_endpoint", "invalidation_conditions", "not_run_statement_vi",
    ):
        assert field in prereg, f"pre_registration thiếu trường: {field}"
    assert prereg["not_run_statement_vi"].startswith("Chưa chạy")


def test_pre_registration_hypotheses_cover_four_morphology_unknowns(prereg):
    hyps = prereg["hypotheses"]
    assert [h["id"] for h in hyps] == ["H1", "H2", "H3", "H4"]
    joined = " ".join(h["morphology_unknown_vi"] for h in hyps).lower()
    for phrase in ("số sườn", "chân vòm", "phân đoạn", "tháp"):
        assert phrase in joined, f"hypotheses thiếu ẩn số hình thái: {phrase}"
    for h in hyps:
        assert h["falsifier_vi"].strip()
        assert h["what_would_decide_it"]["evidence_kinds"]
        assert h["status"] == "NOT_TESTED"


def test_pre_registration_l0_protocol_thresholds_come_from_caller(prereg):
    protocol = prereg["l0_screening_protocol"]
    assert protocol["current_state"] == "THRESHOLDS_NOT_YET_PROVIDED"
    check_ids = [c["check_id"] for c in protocol["checks"]]
    for expected in ("ARCH-L0-FAB", "ARCH-L0-LIFT", "ARCH-L0-ERECTION", "ARCH-L0-INSPECTION"):
        assert expected in check_ids, f"thiếu check {expected}"
    for check in protocol["checks"]:
        assert check["status"] == "THRESHOLDS_NOT_YET_PROVIDED"
        assert "logistics_profile" in check["threshold_source"]
    assert "UNKNOWN_INPUT_MISSING" in protocol["threshold_policy_vi"]


def test_pre_registration_diversity_rule_is_objective_free(prereg):
    rule = prereg["diversity_selection_rule"]
    assert rule["selection_is_objective_free"] is True
    assert set(rule["coverage_quota_keys"]) == {
        "arch_axis_type", "spandrel_system", "springing_restraint",
        "thrust_restraint_system"}
    assert prereg["primary_endpoint"]["performance_endpoint"] is None


def test_pre_registration_no_invented_lit_ids(literature_ids):
    text = PREREG_PATH.read_text(encoding="utf-8")
    assert LIT_TOKEN_RE.search(text), "pre_registration phải viện dẫn ít nhất một nguồn"
    bad = _lit_tokens_with_problems(text, literature_ids)
    assert not bad, f"pre_registration nhắc tới reference_id bịa hoặc sai dạng: {bad}"


def test_pre_registration_no_performance_number_and_no_overclaim(prereg):
    for path, key, value in _walk(prereg):
        low = str(key).lower()
        if low in FORBIDDEN_VALUE_KEYS:
            assert value is None, f"{path} = {value!r} — false precision"
        assert low not in FORBIDDEN_BLOCK_KEYS, f"{path}: khối kết quả bị cấm"
        if low.endswith(FORBIDDEN_UNIT_SUFFIXES):
            assert value is None, f"{path} = {value!r} — số có đơn vị chưa có solver"
    _assert_no_unnegated_overclaim(PREREG_PATH.read_text(encoding="utf-8"))


def test_pre_registration_check_ids_map_onto_the_ids_the_module_really_emits(prereg):
    """Nhãn nhóm trong hồ sơ phải truy được về check_id chạy thật.

    Hồ sơ dùng nhãn nhóm ARCH-L0-FAB/LIFT/ERECTION/INSPECTION, còn module phát ra
    ARCH-L0-01..07. Nếu hai bên trôi khỏi nhau thì hồ sơ mô tả một cơ chế không
    tồn tại — đúng kiểu lệch phát biểu–cơ chế mà BRD-022 ghi lại. Test này khoá
    ánh xạ: mọi id trong ``implemented_check_ids`` phải có trong output thật, và
    mọi check thật phải được ít nhất một nhóm nhận.
    """
    emitted = _l0_checks_by_id(
        screen_constructability_l0(
            _l0_geometry(), _l0_full_profile(), _l0_segmentation()
        )
    )
    claimed = set()
    for group in prereg["l0_screening_protocol"]["checks"]:
        assert group["check_id_is_a_group_label"] is True, group["check_id"]
        mapped = group["implemented_check_ids"]
        assert mapped, f"{group['check_id']} không ánh xạ tới check_id nào"
        for item in mapped:
            check_id = item["check_id"]
            assert check_id in emitted, (
                f"{group['check_id']} khai check_id {check_id} mà module không phát ra"
            )
            assert item["title_vi"] == emitted[check_id]["title_vi"], (
                f"{check_id}: title_vi trong hồ sơ lệch khỏi title_vi module phát ra"
            )
            claimed.add(check_id)
    assert claimed == set(emitted), (
        f"check thật không được nhóm nào nhận: {sorted(set(emitted) - claimed)}"
    )
    assert "ARCH-L0-01..07" in prereg["l0_screening_protocol"]["id_mapping_note_vi"]
    assert (
        prereg["modules"]["l0_constructability_screening"]
        == "bridge_evolution/geometry_experimental/arch_l0_constructability.py"
    )
