        geometry_hash([("span_m", 200.0)])  # không phải dict


def test_lineage_block_is_complete_and_contains_no_forbidden_keys():
    parent = geometry_hash(dict(BASE))
    out = arch_geometry(**BASE, parent_geometry_hash=parent,
                        generation_action="MUTATE_RISE")
    lin = out["lineage"]
    assert lin["parent_geometry_hash"] == parent
    assert lin["generation_action"] == "MUTATE_RISE"
    assert lin["generator_id"] == ag.GENERATOR_ID
    assert lin["generator_version"] == ag.GENERATOR_VERSION
    # Metadata phả hệ KHÔNG tham gia hash: cùng tham số -> cùng geometry_hash.
    assert lin["geometry_hash"] == parent
    for path, key, _ in _walk(lin):
        assert key.lower() not in FORBIDDEN_VALUE_KEYS, path
        assert key.lower() not in FORBIDDEN_BLOCK_KEYS, path


def test_lineage_hash_matches_production_canonical_json_convention():
    """hash_inputs + quy ước canonical JSON của state.py phải tái tạo đúng hash."""
    out = arch_geometry(**BASE)
    payload = {
        "generator_id": ag.GENERATOR_ID,
        "generator_version": ag.GENERATOR_VERSION,
        "params": out["lineage"]["hash_inputs"],
    }
    expected = hashlib.sha256(
        json.dumps(payload, sort_keys=True, separators=(",", ":"),
                   ensure_ascii=False).encode("utf-8")
    ).hexdigest()
    assert out["lineage"]["geometry_hash"] == expected


def test_lineage_case_id_format():
    h = geometry_hash(dict(BASE))
    cid = geometry_case_id(h)
    assert cid == "ARCH-" + h[:16]
    assert re.fullmatch(r"ARCH-[0-9a-f]{16}", cid)
    for bad in ["abc", "A" * 64, None, 5, h + "0"]:
        with pytest.raises(ArchGeometryError):
            geometry_case_id(bad)


def test_lineage_hash_param_defaults_match_arch_geometry_signature():
    """Chống trôi: default của geometry_hash phải khớp chữ ký arch_geometry."""
    sig = inspect.signature(arch_geometry)
    for name, default in ag._HASH_PARAM_DEFAULTS.items():
        assert sig.parameters[name].default == default, name


# ---------------------------------------------------------------------------
# 11. L0 chế tạo / vận chuyển / cẩu lắp / inspection access (ARCH-L0-xx)
# ---------------------------------------------------------------------------
# Mọi ngưỡng dưới đây là FIXTURE CỦA TEST, không phải giá trị kỹ thuật.

L0_PROV = "TEST_FIXTURE_NOT_ENGINEERING_VALUE"


def _l0_threshold(value):
    return {"value": value, "provenance": L0_PROV}


def _l0_geometry():
    return arch_geometry(**BASE, deck_width_m=20.0, rib_count=2)


def _l0_segmentation(**overrides):
    seg = {
        "segment_count_per_rib": 8,
        "rib_section_area_m2": 0.5,
        "rib_material_density_kg_m3": 7850.0,
        "rib_width_m": 1.0,
        "provenance": L0_PROV,
    }
    seg.update(overrides)
    return seg


def _l0_full_profile():
    return {
        "max_transport_segment_length_m": _l0_threshold(30.0),
        "max_lift_piece_mass_t": _l0_threshold(150.0),
        "min_inspection_walkway_clearance_m": _l0_threshold(2.0),
        "min_spandrel_column_height_for_inspection_m": _l0_threshold(2.0),
        "min_rib_clear_gap_m": _l0_threshold(5.0),
        "max_cantilever_half_arch_segments": _l0_threshold(4),
    }


def _l0_checks_by_id(out):
    return {c["check_id"]: c for c in out["checks"]}


def test_l0_missing_threshold_yields_unknown_and_blocks_all_known_pass():
    """Fail-closed: thiếu ngưỡng -> UNKNOWN, và UNKNOWN chặn all_known_pass.

    QUY ƯỚC (khoá lại bằng test): all_known_pass=True CHỈ khi không có FAIL
    và KHÔNG có UNKNOWN. Thiếu dữ liệu không bao giờ được hiểu ngầm là đạt.
    """
    out = screen_constructability_l0(
        _l0_geometry(), {}, {"segment_count_per_rib": 8, "provenance": L0_PROV}
    )
    by_id = _l0_checks_by_id(out)
    # ARCH-L0-03 (số đốt chẵn) là check topo, không cần ngưỡng ngoài -> PASS.
    assert by_id["ARCH-L0-03"]["status"] == "PASS"
    for check_id, check in by_id.items():
        if check_id == "ARCH-L0-03":
            continue
        assert check["status"] == "UNKNOWN_INPUT_MISSING", check_id
        assert check["message_vi"].strip(), check_id
    assert out["any_unknown"] is True
    assert out["any_fail"] is False
    assert out["all_known_pass"] is False, (
        "all_known_pass phải False khi còn UNKNOWN — thiếu dữ liệu không phải PASS"
    )


def test_l0_pass_direction_all_known_pass_only_when_every_check_passes():
    out = screen_constructability_l0(
        _l0_geometry(), _l0_full_profile(), _l0_segmentation()
    )
    assert len(out["checks"]) == 7
    assert all(c["status"] == "PASS" for c in out["checks"])
    assert out["status_counts"] == {"PASS": 7, "FAIL": 0, "UNKNOWN_INPUT_MISSING": 0}
    assert out["all_known_pass"] is True
    assert out["any_fail"] is False and out["any_unknown"] is False
    # Mỗi check PASS vẫn phải mang provenance của ngưỡng (trừ check topo).
    for c in out["checks"]:
        assert c["limit_provenance"], c["check_id"]
        if c["check_id"] != "ARCH-L0-03":
            assert c["limit_provenance"] == L0_PROV, c["check_id"]


def test_l0_fail_direction_each_check_fails_the_right_way():
    """Ngưỡng siết chặt -> FAIL đúng check, đúng chiều so sánh."""
    tight = {
        "max_transport_segment_length_m": _l0_threshold(10.0),
        "max_lift_piece_mass_t": _l0_threshold(50.0),
        "min_inspection_walkway_clearance_m": _l0_threshold(25.0),
        "min_spandrel_column_height_for_inspection_m": _l0_threshold(25.0),
        "min_rib_clear_gap_m": _l0_threshold(25.0),
        "max_cantilever_half_arch_segments": _l0_threshold(3),
    }
    out = screen_constructability_l0(_l0_geometry(), tight, _l0_segmentation())
    by_id = _l0_checks_by_id(out)
    for check_id in ("ARCH-L0-01", "ARCH-L0-02", "ARCH-L0-04",
                     "ARCH-L0-05", "ARCH-L0-06", "ARCH-L0-07"):
        assert by_id[check_id]["status"] == "FAIL", check_id
    assert by_id["ARCH-L0-03"]["status"] == "PASS"
    assert out["any_fail"] is True and out["all_known_pass"] is False
    # FAIL cột thấp phải gợi ý tường khoang vòm đặc (khớp notes_vi arch_geometry).
    assert "tường khoang" in by_id["ARCH-L0-06"]["message_vi"].lower()
    # Giá trị/giới hạn phải nhất quán chiều: value vượt/không đạt limit thật.
    assert by_id["ARCH-L0-01"]["value"] > by_id["ARCH-L0-01"]["limit"]
    assert by_id["ARCH-L0-05"]["value"] < by_id["ARCH-L0-05"]["limit"]


def test_l0_odd_segment_count_fails_erection_closure_check():
    """Số đốt LẺ không raise — nó là kết quả sàng lọc FAIL của ARCH-L0-03."""
    out = screen_constructability_l0(
        _l0_geometry(), _l0_full_profile(), _l0_segmentation(segment_count_per_rib=7)
    )
    assert _l0_checks_by_id(out)["ARCH-L0-03"]["status"] == "FAIL"
    assert out["any_fail"] is True
    assert out["all_known_pass"] is False


def test_l0_output_contains_no_forbidden_key():
    """Không khoá hiệu năng nào trong toàn bộ cây output (fail-closed L0)."""
    out = screen_constructability_l0(
        _l0_geometry(), _l0_full_profile(), _l0_segmentation()
    )
    for path, key, value in _walk(out):
        low = key.lower()
        assert low not in FORBIDDEN_VALUE_KEYS, f"{path}: {key}"
        assert low not in FORBIDDEN_BLOCK_KEYS, f"{path}: {key}"
        if low.endswith(FORBIDDEN_UNIT_SUFFIXES):
            assert value is None, f"{path} = {value!r}"


