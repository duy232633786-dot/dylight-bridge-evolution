    out = arch_geometry(**BASE)
    for path, key, value in _walk(out):
        assert key.lower() not in FORBIDDEN_VALUE_KEYS, f"{path}: {key}"


# ---------------------------------------------------------------------------
# 9. Báo cáo có đủ các mục bắt buộc
# ---------------------------------------------------------------------------

def test_report_has_required_sections():
    text = REPORT_PATH.read_text(encoding="utf-8")
    for heading in (
        "F0 IDEA",
        "Những gì bức ảnh KHÔNG cho biết",
        "Cần gì để đi tiếp",
        "G0",
        "G7",
    ):
        assert heading in text, f"Báo cáo thiếu mục: {heading}"
    _assert_no_unnegated_overclaim(text)


#: Cửa sổ ký tự TRƯỚC từ khoá được coi là "cùng mệnh đề". Phủ định ở xa hơn —
#: hoặc ở mệnh đề khác trên cùng dòng — không được tính là phủ định.
NEGATION_WINDOW_CHARS = 70
NEGATION_TOKENS = ("không", "chưa", "chẳng")
#: Dấu ngắt mệnh đề: phủ định bên kia dấu ngắt thuộc mệnh đề khác.
CLAUSE_BREAK_RE = re.compile(r"[;:\u2014]|(?<![0-9]),(?![0-9])")


def _assert_no_unnegated_overclaim(text: str) -> None:
    """Mỗi lần xuất hiện 'khả thi'/'thi công được' phải có phủ định SÁT nó.

    Bản cũ chỉ hỏi cả DÒNG có chữ 'không' nào không, nên câu "Phương án A hoàn
    toàn khả thi và chi phí không cao." vẫn lọt (phản biện BRD-004 tái hiện được).
    """
    offenders = []
    for banned in ("khả thi", "thi công được"):
        start = 0
        while True:
            i = text.find(banned, start)
            if i == -1:
                break
            start = i + len(banned)
            line_start = text.rfind("\n", 0, i) + 1
            window = text[max(line_start, i - NEGATION_WINDOW_CHARS):i].lower()
            breaks = list(CLAUSE_BREAK_RE.finditer(window))
            clause = window[breaks[-1].end():] if breaks else window
            if not any(tok in clause for tok in NEGATION_TOKENS):
                line_end = text.find("\n", i)
                offenders.append(text[line_start:line_end if line_end != -1 else None])
    assert not offenders, (
        f"Khẳng định vượt mức claim (thiếu phủ định trong cùng mệnh đề): {offenders}"
    )


# ---------------------------------------------------------------------------
# 10. LINEAGE — geometry hash tái lập được (BRD-004, tiêu chí #2)
# ---------------------------------------------------------------------------

def test_lineage_hash_is_deterministic_in_process():
    out1 = arch_geometry(**BASE)
    out2 = arch_geometry(**BASE)
    h = geometry_hash(dict(BASE))
    assert out1["lineage"]["geometry_hash"] == out2["lineage"]["geometry_hash"] == h
    # Thứ tự khoá của dict không ảnh hưởng (canonical JSON sort_keys).
    reordered = dict(sorted(BASE.items(), reverse=True))
    assert geometry_hash(reordered) == h
    # Chuẩn hoá kiểu: int và float cùng giá trị băm ra cùng hash.
    as_ints = {k: int(v) for k, v in BASE.items()}
    assert geometry_hash(as_ints) == h


def test_lineage_hash_is_deterministic_across_two_subprocesses():
    code = (
        "from bridge_evolution.geometry_experimental.arch_geometry "
        f"import geometry_hash; print(geometry_hash({dict(BASE)!r}))"
    )
    runs = [
        subprocess.run(
            [sys.executable, "-c", code],
            capture_output=True, text=True, cwd=ROOT, check=True,
        ).stdout.strip()
        for _ in range(2)
    ]
    assert runs[0] == runs[1], "hash đổi giữa hai process — không tái lập được"
    assert runs[0] == geometry_hash(dict(BASE))
    assert re.fullmatch(r"[0-9a-f]{64}", runs[0])


