@pytest.mark.parametrize(
    "module",
    [ag, al0, sd],
    ids=["arch_geometry", "arch_l0_constructability", "shape_diversity"],
)
def test_geometry_module_exposes_no_analysis_function(module):
    banned = re.compile(
        r"(force|moment|stress|strain|solve|analy|capacity|utilis|utiliz|buckl|"
        r"reaction|thrust|deflect|fatigue)",
        re.IGNORECASE,
    )
    offenders = [
        name for name in dir(module)
        if callable(getattr(module, name)) and banned.search(name)
    ]
    assert not offenders, (
        f"Module {module.__name__} lộ hàm mang tính phân tích: {offenders}. "
        "Runtime không có solver cho vòm và không được giả vờ có."
    )


