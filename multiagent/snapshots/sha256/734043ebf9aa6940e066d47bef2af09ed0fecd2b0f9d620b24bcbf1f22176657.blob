"""Kiểm tra sandbox hình thái thực nghiệm BRD-004 (họ vòm chạy trên).

Bốn nhóm bảo vệ, theo thứ tự quan trọng:

1. CHỐNG BỊA NGUỒN — mọi ``reference_id`` và mọi chuỗi dạng ``LIT-nnn`` xuất
   hiện trong grammar thực nghiệm VÀ trong báo cáo phải tồn tại thật trong
   ``research/literature/index.json``. Đây là test quan trọng nhất của file.
2. CHỐNG FALSE PRECISION — không trường số liệu hiệu năng nào được điền.
3. CÁCH LY SANDBOX — grammar thực nghiệm không được lọt vào production grammar.
4. HÌNH HỌC — toạ độ hợp lệ, và tham số phi vật lý phải raise.
"""

import hashlib
import inspect
import json
import re
import subprocess
import sys
from pathlib import Path

import pytest

from bridge_evolution.catalogs import grid_domain, load_grammar
from bridge_evolution.geometry_experimental import arch_geometry as ag
from bridge_evolution.geometry_experimental import arch_l0_constructability as al0
from bridge_evolution.geometry_experimental import shape_diversity as sd
from bridge_evolution.geometry_experimental.arch_geometry import (
    ArchGeometryError,
    arch_axis_polyline,
    arch_geometry,
    catenary_parameter,
    geometry_case_id,
    geometry_hash,
    rib_transverse_offsets_m,
    spandrel_column_lines,
)
from bridge_evolution.geometry_experimental.arch_l0_constructability import (
    screen_constructability_l0,
)
from bridge_evolution.geometry_experimental.shape_diversity import (
    ShapeDiversityError,
    enumerate_topology_hypotheses,
    select_diverse_top_set,
)

ROOT = Path(__file__).resolve().parent.parent
GRAMMAR_PATH = ROOT / "bridge_grammar" / "experimental" / "arch_deck_v1.json"
REPORT_PATH = ROOT / "experiments" / "shape_discovery" / "arch_render_study.md"
PREREG_PATH = ROOT / "experiments" / "shape_discovery" / "pre_registration.json"
LITERATURE_INDEX = ROOT / "research" / "literature" / "index.json"

LIT_ID_RE = re.compile(r"LIT[-_](\d{3})")
#: Quét RỘNG: bắt cả biến thể dị dạng (LIT-99, lit-055b, LIT_0555) để chúng
#: không lách qua lưới rồi được đọc như một nguồn có thật. Chỉ dạng chuẩn
#: LIT-<3 chữ số> viết hoa mới được coi là hợp lệ.
LIT_TOKEN_RE = re.compile(r"\bLIT[-_][A-Za-z0-9]+", re.IGNORECASE)
CANONICAL_LIT_RE = re.compile(r"\ALIT-\d{3}\Z")


def _lit_tokens_with_problems(text: str, literature_ids: set) -> list[str]:
    """Token dị dạng HOẶC không có trong thư viện. Dị dạng cũng là bịa nguồn."""
    bad = []
    for tok in LIT_TOKEN_RE.findall(text):
        if not CANONICAL_LIT_RE.match(tok):
            bad.append(f"{tok} (sai dạng — phải là LIT-<3 chữ số> viết hoa)")
        elif tok not in literature_ids:
            bad.append(f"{tok} (không có trong index.json)")
    return sorted(set(bad))

#: Tên khoá bị cấm mang giá trị khác null — đây là các đại lượng HIỆU NĂNG mà
#: runtime hiện KHÔNG có phương tiện tính cho họ vòm (RCM-2.0.0: SOLVER_MIDAS_CIVIL,
#: SOLVER_OPENSEESPY, GRILLAGE_3D, STAGED_PRESTRESS_EFFECTS đều ABSENT).
FORBIDDEN_VALUE_KEYS = {
    "utilization",
    "utilisation",
    "capacity",
    "demand",
    "moment",
    "shear",
    "axial_force",
    "stress",
    "deflection",
    "natural_frequency",
    "safety_factor",
    "buckling_load",
    "thrust_kn",
    "cost",
    "carbon",
    "mass",
    "score",
    "margin",
    "reserve",
}

#: Khối kết quả không được tồn tại trong một grammar mức IDEA.
FORBIDDEN_BLOCK_KEYS = {"results", "evaluation", "objective_values", "verdict_numbers"}

#: Hậu tố đơn vị vật lý: nếu xuất hiện thì giá trị phải là null (chưa có solver).
FORBIDDEN_UNIT_SUFFIXES = ("_kn", "_knm", "_mpa", "_kpa", "_mm2", "_hz")


# ---------------------------------------------------------------------------
# Tiện ích
# ---------------------------------------------------------------------------

def _load_json(path: Path) -> dict:
    with open(path, encoding="utf-8") as f:
        return json.load(f)


def _walk(node, path="$"):
    """Duyệt toàn bộ cây JSON, sinh ``(đường_dẫn, khoá, giá_trị)``."""
    if isinstance(node, dict):
        for key, value in node.items():
            yield f"{path}.{key}", key, value
            yield from _walk(value, f"{path}.{key}")
    elif isinstance(node, list):
        for i, value in enumerate(node):
            yield from _walk(value, f"{path}[{i}]")


@pytest.fixture(scope="module")
def grammar():
    return _load_json(GRAMMAR_PATH)


@pytest.fixture(scope="module")
def literature_ids():
    index = _load_json(LITERATURE_INDEX)
    return {ref["reference_id"] for ref in index["references"]}


# ---------------------------------------------------------------------------
# 1. CHỐNG BỊA NGUỒN — test quan trọng nhất
# ---------------------------------------------------------------------------

def test_literature_index_is_readable(literature_ids):
    """Index đọc được và không mất nguồn cũ.

    Trước đây test khoá cứng `== 111`, nên mỗi đợt quét bổ sung lại làm đỏ một
    test thuộc file khác — trong khi điều test này thực sự cần bảo vệ là
    "grammar không được trỏ tới reference_id bịa". Thư viện chỉ được phép LỚN
    lên; ID cũ biến mất mới là lỗi. Số lượng chính xác do
    `tests/test_literature_index.py` neo cùng `counts` trong index.
    """
    assert len(literature_ids) >= 111
    assert "LIT-055" in literature_ids


def test_sources_non_empty_and_all_exist_in_literature_index(grammar, literature_ids):
    sources = grammar["sources"]
    assert isinstance(sources, list) and sources, "sources không được rỗng"
    assert len(sources) == len(set(sources)), "sources có reference_id trùng"
    missing = [s for s in sources if s not in literature_ids]
    assert not missing, f"reference_id KHÔNG tồn tại trong index.json: {missing}"


def test_every_reference_id_field_is_null_or_real(grammar, literature_ids):
    for path, key, value in _walk(grammar):
        if key != "reference_id":
            continue
        assert value is None or value in literature_ids, (
            f"{path} = {value!r} — reference_id bịa hoặc sai chính tả"
        )


def test_no_invented_lit_ids_anywhere_in_grammar_text(literature_ids):
    text = GRAMMAR_PATH.read_text(encoding="utf-8")
    bad = _lit_tokens_with_problems(text, literature_ids)
    assert not bad, f"Grammar nhắc tới reference_id bịa hoặc sai dạng: {bad}"


def test_no_invented_lit_ids_anywhere_in_report_text(literature_ids):
    text = REPORT_PATH.read_text(encoding="utf-8")
    assert LIT_TOKEN_RE.search(text), "Báo cáo phải viện dẫn ít nhất một nguồn"
    bad = _lit_tokens_with_problems(text, literature_ids)
    assert not bad, f"Báo cáo nhắc tới reference_id bịa hoặc sai dạng: {bad}"


def test_non_indexed_sources_are_flagged_not_hidden(grammar, literature_ids):
    """Nguồn ngoài thư viện phải được khai báo tường minh với reference_id = null."""
    for entry in grammar["non_indexed_sources"]:
        assert entry["reference_id"] is None
        assert entry["evidence_status"] in {
            "NOT_IN_VERIFIED_LIBRARY",
            "AI_GENERATED_SLIDES_NOT_EVIDENCE",
        }
    for prec in grammar["precedents"]:
        rid = prec["reference_id"]
        assert rid is None or rid in literature_ids
        if rid is None:
            assert prec["evidence_status"] == "NOT_IN_VERIFIED_LIBRARY"


# ---------------------------------------------------------------------------
# 2. Grammar validate được + mọi biến có miền RỜI RẠC
# ---------------------------------------------------------------------------

def test_grammar_header_fields(grammar):
    assert grammar["family_id"]
    assert grammar["status"] == "EXPERIMENTAL"
    assert grammar["claim_level"] == "IDEA"
    assert grammar["task_id"] == "BRD-004"
    for block in (
        "load_path_hypothesis",
        "falsification_criterion",
        "design_variables",
        "constraints_needed",
        "precedents",
        "sources",
    ):
        assert block in grammar, f"Thiếu khối bắt buộc: {block}"


def test_sandbox_policy_declares_runtime_cannot_evaluate(grammar):
    policy = grammar["sandbox_policy"]
    assert policy["production_import_forbidden"] is True
    assert policy["runtime_can_evaluate_this_family"] is False
    absent = policy["runtime_evidence"]["absent_capabilities_blocking_this_family"]
    assert {"SOLVER_OPENSEESPY", "GRILLAGE_3D", "STAGED_PRESTRESS_EFFECTS"} <= set(absent)


def test_every_design_variable_has_discrete_finite_domain(grammar):
    variables = grammar["design_variables"]
    assert variables, "design_variables rỗng"
    for name, spec in variables.items():
        assert spec["type"] in {"catalog", "int", "grid"}, name
        domain = grid_domain(spec)  # dùng chính hàm của runtime: chứng minh rời rạc
        assert isinstance(domain, list) and domain, f"{name}: miền rỗng"
        assert len(domain) == len(set(domain)), f"{name}: miền có giá trị trùng"
        assert len(domain) < 10_000, f"{name}: miền quá lớn, không còn là rời rạc hữu ích"


def test_every_design_variable_declares_domain_provenance(grammar):
    """Miền số không được xuất hiện như một kết quả — phải khai xuất xứ."""
    allowed = {
        "ENUMERATED_TOPOLOGY",
        "NON_INDEXED_SOURCE",
        "SOURCE_LIT_055",
        "SOURCE_LIT_054_LIT_055",
        "PLACEHOLDER_PENDING_DESIGN_BASIS",
    }
    for name, spec in grammar["design_variables"].items():
        prov = spec.get("domain_provenance")
        assert prov in allowed, f"{name}: domain_provenance thiếu hoặc lạ ({prov!r})"
        if prov == "PLACEHOLDER_PENDING_DESIGN_BASIS":
            assert spec.get("blocks_claim_above") == "IDEA", (
                f"{name}: miền placeholder phải khoá claim ở IDEA"
            )


def test_stage_dimension_present_from_the_start(grammar):
    """INC-004: grammar phải mang trường GIAI ĐOẠN ngay từ định nghĩa."""
    stage_var = grammar["design_variables"]["construction_stage_id"]
    assert stage_var["type"] == "catalog"
    stage_ids = {s["id"] for s in grammar["construction_stage_schema"]["stages"]}
    assert set(stage_var["domain"]) == stage_ids
    assert "S2_CANTILEVER_ERECTION" in stage_ids
    assert "S7_SERVICE" in stage_ids


def test_project_inputs_are_unknown_not_invented(grammar):
    """Ảnh không cho biết khẩu độ/địa chất/tải trọng — phải là null hoặc TBD."""
    for key, value in grammar["project_inputs"].items():
        if key.startswith("_"):
            continue
        assert value is None or value == "TBD" or value == ["TBD"], (
            f"project_inputs.{key} = {value!r} — không được bịa dữ liệu design basis"
        )


# ---------------------------------------------------------------------------
# 3. load_path_hypothesis và falsification_criterion khác rỗng
# ---------------------------------------------------------------------------

def test_load_path_hypothesis_is_a_complete_chain(grammar):
    lph = grammar["load_path_hypothesis"]
    steps = lph["steps"]
    assert len(steps) >= 5, "Đường lực phải đi từ bánh xe xuống tận nền"
    allowed_actions = {"NEN", "KEO", "UON", "CAT", "HON_HOP", "KHONG_XAC_DINH"}
    for step in steps:
        assert step["from"].strip()
        assert step["to"].strip()
        assert step["action"] in allowed_actions
    assert [s["step"] for s in steps] == list(range(1, len(steps) + 1))
    assert lph["closure_element"].strip()
    assert "đá" in lph["closure_element"].lower()
    assert lph["parallel_branch_lateral"], "Thiếu nhánh lực NGANG (gió/động đất)"
    assert lph["sign_reversal_warning_vi"].strip()
    assert lph["unresolved_in_load_path"], "Phải ghi rõ phần đường lực còn ẩn số"


def test_falsification_criterion_non_empty_and_untested(grammar):
    fc = grammar["falsification_criterion"]
    assert fc["family_rejected_if"].strip()
    falsifiers = fc["falsifiers"]
    assert len(falsifiers) >= 3
    for f in falsifiers:
        assert f["id"].strip()
        assert f["statement_vi"].strip()
        assert f["status"] == "NOT_TESTED", (
            f"{f['id']}: không falsifier nào đã được kiểm — runtime không có "
            "phương tiện đánh giá vòm"
        )


def test_constraints_needed_lists_the_missing_runtime_checks(grammar):
    needed = grammar["constraints_needed"]
    titles = " ".join(c["title_vi"] for c in needed).lower()
    for keyword in ("ổn định", "thi công", "lực xô", "gió", "mỏi"):
        assert keyword in titles, f"constraints_needed thiếu hạng mục: {keyword}"
    for c in needed:
        assert c["runtime_state"] in {"ABSENT", "PARTIAL"}
        assert c["blocks_claim_above"] == "IDEA"


# ---------------------------------------------------------------------------
# 4. CHỐNG FALSE PRECISION
# ---------------------------------------------------------------------------

def test_no_performance_number_is_filled(grammar):
    for path, key, value in _walk(grammar):
        low = key.lower()
        if low in FORBIDDEN_VALUE_KEYS:
            assert value is None, f"{path} = {value!r} — false precision"
        if low.endswith(FORBIDDEN_UNIT_SUFFIXES):
            assert value is None, f"{path} = {value!r} — số có đơn vị chưa có solver"


def test_no_result_block_exists(grammar):
    for path, key, _ in _walk(grammar):
        assert key.lower() not in FORBIDDEN_BLOCK_KEYS, f"{path}: khối kết quả bị cấm"


def test_performance_fields_block_is_all_null(grammar):
    fields = grammar["performance_fields"]
    filled = {k: v for k, v in fields.items() if not k.startswith("_") and v is not None}
    assert not filled, f"performance_fields đã bị điền: {filled}"


def test_precedent_spans_are_not_asserted(grammar):
    """Khẩu độ của công trình tiền lệ nằm trong unverified_fields của nguồn."""
    for prec in grammar["precedents"]:
        assert prec["main_span_m"] is None, (
            f"{prec['id']}: không được gán khẩu độ — LIT-054/LIT-055 đều liệt kê "
            "khẩu độ cụ thể trong unverified_fields"
        )


def test_derivation_is_shown_step_by_step(grammar):
    """Con số duy nhất được phép có là con số SUY RA, và phải trình bày từng bước."""
    d = grammar["derivations"]["thrust_to_vertical_ratio"]
    assert len(d["steps"]) >= 3
    table = d["table_L_over_f_to_H_over_V"]
    for l_over_f, h_over_v in table.items():
        assert abs(h_over_v - int(l_over_f) / 4.0) < 1e-12, (
            f"L/f={l_over_f}: bảng không khớp chính công thức H/V = (L/f)/4"
        )
    assert d["scope_warning_vi"].strip()
    assert d["friction_and_bearing_values"].startswith("TBD")


# ---------------------------------------------------------------------------
# 5. CÁCH LY SANDBOX
# ---------------------------------------------------------------------------

def test_experimental_grammar_lives_only_in_sandbox():
    assert GRAMMAR_PATH.exists()
    top_level = sorted(p.name for p in (ROOT / "bridge_grammar").glob("*.json"))
    assert "arch_deck_v1.json" not in top_level
    assert top_level == ["super_t_parametric_v2.json", "super_t_simple_v1.json"]


def test_flat_grammar_name_does_not_reach_the_experimental_grammar():
    """Tra bằng TÊN PHẲNG thì không tới được sandbox. Đây là bất biến YẾU."""
    with pytest.raises(FileNotFoundError):
        load_grammar("arch_deck_v1")
    with pytest.raises(FileNotFoundError):
        load_grammar("arch_deck_cfst_skeleton_v1")


def test_loader_does_traverse_into_sandbox_documented_not_safe():
    """Test ĐẶC TẢ SỰ THẬT, không phải test an toàn.

    Phản biện BRD-004: artifact từng khẳng định load_grammar() "không nạp được"
    sandbox. SAI — catalogs.py dựng GRAMMAR_DIR/f"{grammar_id}.json" và không
    chặn dấu "/". Test này KHOÁ hành vi thật lại: nếu ai đó siết loader thì test
    đỏ và buộc phải cập nhật cả phát biểu an toàn trong grammar. Việc siết loader
    nằm NGOÀI write_scope BRD-004 nên đã tách thành task riêng.
    """
    g = load_grammar("experimental/arch_deck_v1")
    assert g["family_id"] == "arch_deck_cfst_skeleton_v1"
    assert g["claim_level"] == "IDEA"


def test_state_schema_is_the_real_barrier_against_the_arch_family(grammar):
    """Hàng rào THẬT: enum "family" của schema state không chứa họ vòm."""
    schema = json.loads(
        (ROOT / "contracts" / "bridge_design_state.schema.json").read_text(
            encoding="utf-8"))

    def find_family_enum(node):
        if isinstance(node, dict):
            fam = node.get("family")
            if isinstance(fam, dict) and "enum" in fam:
                return fam["enum"]
            for value in node.values():
                found = find_family_enum(value)
                if found is not None:
                    return found
        elif isinstance(node, list):
            for value in node:
                found = find_family_enum(value)
                if found is not None:
                    return found
        return None

    enum = find_family_enum(schema)
    assert enum is not None, "Schema state không còn khoá 'family' bằng enum"
    assert grammar["family_id"] not in enum
    assert set(enum) == {"super_t_simple_v1", "super_t_parametric_v2"}


def test_sandbox_policy_must_not_claim_the_loader_blocks_it():
    """Phát biểu an toàn phải khớp cơ chế ĐO ĐƯỢC, không được nói quá."""
    policy = json.loads(GRAMMAR_PATH.read_text(encoding="utf-8"))["sandbox_policy"]
    measured = policy["isolation_mechanism_measured"]
    assert measured["load_grammar_with_slash"].startswith("NOT_BLOCKED")
    assert measured["gene_order_gene_domains"].startswith("NOT_BLOCKED")
    assert measured["state_schema_family_enum"].startswith("BLOCKED")
    assert measured["budgeted_evaluator"].startswith("BLOCKED_BY_ACCIDENT")


def test_production_grammars_do_not_reference_the_arch_family(grammar):
    family_id = grammar["family_id"]
    for name in ("super_t_simple_v1", "super_t_parametric_v2"):
        prod = load_grammar(name)
        text = json.dumps(prod, ensure_ascii=False)
        assert family_id not in text
        assert "arch" not in prod["grammar_id"].lower()


def test_experimental_geometry_module_is_not_imported_by_production():
    """Không file production nào được import gói geometry_experimental."""
    offenders = []
    for py in (ROOT / "bridge_evolution").rglob("*.py"):
        if "geometry_experimental" in py.parts:
            continue
        if "geometry_experimental" in py.read_text(encoding="utf-8"):
            offenders.append(str(py.relative_to(ROOT)))
    assert not offenders, f"Sandbox bị nhập vào production: {offenders}"


# ---------------------------------------------------------------------------
# 6. HÌNH HỌC — toạ độ hợp lệ
# ---------------------------------------------------------------------------

BASE = dict(span_m=200.0, rise_m=40.0, deck_level_m=60.0, bay_count=20)


@pytest.mark.parametrize("axis_type", ["PARABOLA_2ND_ORDER", "CATENARY"])
def test_axis_hits_springings_and_crown(axis_type):
    pts = arch_axis_polyline(200.0, 40.0, axis_type, 101)
    assert pts[0] == {"x_m": 0.0, "y_m": 0.0}
    assert pts[-1]["x_m"] == pytest.approx(200.0)
    assert pts[-1]["y_m"] == pytest.approx(0.0)
    crown = pts[len(pts) // 2]
    assert crown["x_m"] == pytest.approx(100.0)
    assert crown["y_m"] == pytest.approx(40.0, abs=1e-6)


@pytest.mark.parametrize("axis_type", ["PARABOLA_2ND_ORDER", "CATENARY"])
def test_axis_is_symmetric_and_bounded(axis_type):
    pts = arch_axis_polyline(200.0, 40.0, axis_type, 101)
    ys = [p["y_m"] for p in pts]
    assert all(-1e-9 <= y <= 40.0 + 1e-9 for y in ys)
    for i in range(len(ys)):
        assert ys[i] == pytest.approx(ys[-1 - i], abs=1e-6)
    half = len(ys) // 2
    assert all(ys[i] <= ys[i + 1] + 1e-12 for i in range(half))


def test_catenary_parameter_satisfies_its_own_equation():
    import math

    span, rise = 200.0, 40.0
    a = catenary_parameter(span, rise)
    assert a > 0
    assert a * (math.cosh((span / 2.0) / a) - 1.0) == pytest.approx(rise, abs=1e-9)


def test_spandrel_columns_shorten_towards_the_springings():
    lines = spandrel_column_lines(**BASE)
    assert len(lines) == BASE["bay_count"] + 1
    interior = [c for c in lines if not c["at_springing"]]
    assert all(c["height_m"] > 0 for c in interior)
    crown_col = min(interior, key=lambda c: abs(c["x_m"] - 100.0))
    assert crown_col["height_m"] == pytest.approx(20.0, abs=1e-6)
    near_springing = min(interior, key=lambda c: c["x_m"])
    assert near_springing["height_m"] > crown_col["height_m"]


def test_arch_geometry_returns_valid_coordinates_and_claim_flags():
    out = arch_geometry(**BASE, axis_type="PARABOLA_2ND_ORDER", deck_width_m=20.0)
    assert out["claim_level"] == "IDEA"
    assert out["computes_internal_forces"] is False
    assert out["runtime_can_evaluate_this_family"] is False
    assert out["construction_stage_id"] == "S7_SERVICE"
    assert out["span_rise_ratio_L_over_f"] == pytest.approx(5.0)
    assert out["bay_length_m"] == pytest.approx(10.0)
    assert out["axis_arc_length_m"] > out["span_m"]
    assert out["rib_transverse_offsets_m"] == [-10.0, 10.0]
    assert out["min_interior_column_height_m"] == pytest.approx(20.0, abs=1e-6)
    for p in out["axis_points"]:
        assert all(isinstance(p[k], float) for k in ("x_m", "y_m"))


