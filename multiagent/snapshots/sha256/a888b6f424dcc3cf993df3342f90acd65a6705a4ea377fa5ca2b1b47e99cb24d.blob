      "reference_id": "LIT-039",
      "topic": "ADVANCED_MATERIALS_UHPC_FRP",
      "title": "Structural Design with Ultra-High-Performance Concrete",
      "authors": "David Garber, Rafic G. Helou, Benjamin Graybeal (Federal Highway Administration)",
      "year": 2025,
      "venue": "ASPIRE — The Concrete Bridge Magazine, Spring 2025, tr. 50–52 (chuyên mục FHWA)",
      "doi": null,
      "url": "https://www.aspirebridge.com/magazine/2025Spring/FHWA-StructuralDesignWithUltra-High-PerformanceConcrete.pdf",
