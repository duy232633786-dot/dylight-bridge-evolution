    {
      "reference_id": "LIT-132",
      "topic": "DURABILITY_SERVICE_LIFE",
      "title": "ISO 16204:2012 — Durability — Service life design of concrete structures",
      "authors": "ISO/TC 71/SC 3",
      "year": 2012,
      "venue": "International Organization for Standardization, Geneva — 44 trang (trang xác minh: bản chấp nhận nguyên văn SS-ISO 16204:2012 của Thuỵ Điển, approved 30/10/2012; trang gốc iso.org chặn truy cập tự động)",
