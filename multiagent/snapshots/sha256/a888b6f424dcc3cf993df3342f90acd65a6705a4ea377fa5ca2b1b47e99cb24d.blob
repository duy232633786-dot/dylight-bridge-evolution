      "reference_id": "LIT-160",
      "topic": "GEOTECHNICAL_INVESTIGATION",
      "title": "Geotechnical Site Characterization — Geotechnical Engineering Circular No. 5 (GEC-5)",
      "authors": "J. Erik Loehr, Alan Lutenegger, Brent Rosenblad, Andrew Boeckmann",
      "year": 2017,
      "venue": "FHWA / National Highway Institute, báo cáo FHWA-NHI-16-072, 688 trang",
