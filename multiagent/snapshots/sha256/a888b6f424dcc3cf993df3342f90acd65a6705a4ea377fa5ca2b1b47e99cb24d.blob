      "authors": "Sri Sritharan (PI), Sahith Gali",
      "year": 2024,
      "venue": "Bridge Engineering Center, Institute for Transportation (InTrans), Iowa State University — InTrans Project 17-618; tài trợ Iowa DOT và Transportation Pooled Fund TPF-5(366); tháng 6/2024",
      "doi": null,
      "url": "https://www.intrans.iastate.edu/wp-content/uploads/2024/06/evaluation_of_AASHTO_T_397_t2.pdf",
