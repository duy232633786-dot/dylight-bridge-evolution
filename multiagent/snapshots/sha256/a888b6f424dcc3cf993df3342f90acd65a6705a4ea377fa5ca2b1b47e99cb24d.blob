      "reference_id": "LIT-124",
      "topic": "BRIDGE_TYPE_SELECTION",
      "title": "Ranking of Bridge Design Alternatives: A TOPSIS-FADR Method",
      "authors": "M. Keshavarz-Ghorabaee, M. Amiri, E. K. Zavadskas, Z. Turskis, J. Antuchevičienė",
