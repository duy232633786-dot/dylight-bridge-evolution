    {
      "reference_id": "LIT-145",
      "topic": "INSPECTION_MAINTENANCE_BMS",
      "title": "Bridge Preservation Guide — Maintaining a Resilient Infrastructure to Preserve Mobility",
      "authors": "Federal Highway Administration",
      "year": 2018,
      "venue": "FHWA (Spring 2018) — toàn văn mở",
      "doi": null,
      "url": "https://www.fhwa.dot.gov/bridge/preservation/guide/guide.pdf",
