      "reference_id": "LIT-169",
      "topic": "GEOTECHNICAL_INVESTIGATION",
      "title": "Towards reliable and effective site investigations",
      "authors": "M. B. Jaksa, J. S. Goldsworthy, G. A. Fenton, W. S. Kaggwa, D. V. Griffiths, Y. L. Kuo, H. G. Poulos",
      "year": 2005,
      "venue": "Géotechnique, 55(2): 109–121, DOI 10.1680/geot.2005.55.2.109",
      "doi": "10.1680/geot.2005.55.2.109",
