    {
      "reference_id": "LIT-209",
      "topic": "VN_STANDARDS_AASHTO",
      "title": "TCVN 9346:2012 — Kết cấu bê tông và bê tông cốt thép – Yêu cầu bảo vệ chống ăn mòn trong môi trường biển",
      "authors": "Viện Khoa học Công nghệ Xây dựng – Bộ Xây dựng biên soạn",
      "year": 2012,
