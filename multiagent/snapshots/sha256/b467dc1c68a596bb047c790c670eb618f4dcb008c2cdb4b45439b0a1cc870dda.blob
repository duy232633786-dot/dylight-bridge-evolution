"""BRD-050 — vòng lặp thiết kế cấu kiện: REPAIR → TRIM, ngân sách trung thực, lineage."""
from __future__ import annotations

import hashlib
import json
from pathlib import Path

import jsonschema
import pytest

import bridge_evolution.design_loop as loop_module
import bridge_evolution.evaluate as evaluate_module
from bridge_evolution import CONTRACTS_DIR, REPO_ROOT
from bridge_evolution.design_loop import (
    DesignLoopError,
    LoopPolicy,
    load_loop_basis,
    main,
    progress_key,
    progress_stage,
    report_digest,
    rule_utilizations,
    run_design_loop,
    summarize,
)
from bridge_evolution.design_study import load_applicability_registry
from bridge_evolution.evaluate import evaluate_candidate
from bridge_evolution.fe_adapter import SolverError
from bridge_evolution.state import state_from_gene

CASES = REPO_ROOT / "gold_cases" / "cases"
SCHEMA = json.loads((CONTRACTS_DIR / "design_loop_report.schema.json").read_text(encoding="utf-8"))


def _case(name: str) -> dict:
    return json.loads((CASES / name).read_text(encoding="utf-8"))


def _validate(report: dict) -> None:
    errors = list(jsonschema.Draft202012Validator(SCHEMA).iter_errors(report))
    assert not errors, [e.message for e in errors[:5]]
    assert report_digest(report) == report["report_sha256"]


def _accepted_probe(iteration: dict) -> dict | None:
    return next((p for p in iteration["probes"] if p["outcome"] == "ACCEPTED"), None)


# --------------------------------------------------------------- hành vi lõi
def test_gc06_repairs_serv001_then_trims_and_converges():
    report = run_design_loop(_case("GC-06_cheap_but_fails.json"), budget=40)
    _validate(report)
    assert report["seed"]["status"] == "SUCCESS" and not report["seed"]["feasible"]
    assert report["seed"]["violations"][0]["rule_id"] == "SERV-001"

    it1, it2 = report["iterations"][0], report["iterations"][1]
    assert it1["phase"] == "REPAIR" and it2["phase"] == "REPAIR"
    m1, m2 = _accepted_probe(it1)["move"], _accepted_probe(it2)["move"]
    # Bậc thang KC-001: tăng cáp trước; PT-42 vẫn FAIL nhưng cv giảm ⇒ tiến bộ.
    assert (m1["variable"], m1["current"], m1["proposed"]) == ("prestress_layout_id", "PT-38", "PT-42")
    assert m1["card_id"] == "KC-001" and m1["source"] == "diagnose"
    assert not _accepted_probe(it1)["feasible"]
    assert (m2["variable"], m2["proposed"]) == ("prestress_layout_id", "PT-46")
    assert _accepted_probe(it2)["feasible"]
    assert all(it["phase"] == "TRIM" for it in report["iterations"][2:])

    final = report["final"]
    assert final["feasible"] and final["meets_target"] and final["stage_label"] == "ACCEPTABLE"
    assert final["max_utilization"] <= 1.0
    assert final["objectives"]["relative_cost"] < 2146.06  # phương án PT-46 trước TRIM
    assert report["termination"]["reason"] == "CONVERGED"
    assert report["claim_level"] == "SCREENED" and report["claim_ceiling"] == "SCREENED"
    assert report["design_verdict_authority"] == "INDEPENDENT_VERIFIER"
    assert report["loop_authority"] == "NONE"


def test_budget_counts_only_real_solver_calls_and_never_revisits():
    report = run_design_loop(_case("GC-06_cheap_but_fails.json"), budget=25)
    probes = [report["seed"]] + [p for it in report["iterations"] for p in it["probes"]]
    solver_probes = [p for p in probes if p["solver_call_index"] is not None]
    assert report["counters"]["evaluator"]["solver_calls"] == len(solver_probes) <= 25
    assert report["counters"]["loop"]["probes_solver"] == len(solver_probes)
    assert sorted(p["solver_call_index"] for p in solver_probes) == list(range(1, len(solver_probes) + 1))
    hashes = [p["input_hash"] for p in probes]
    assert len(hashes) == len(set(hashes)), "một thiết kế không bao giờ được đánh giá hai lần"
    assert report["counters"]["evaluator"]["cache_hits"] == 0


def test_lineage_parent_chain_is_recorded_in_provenance():
    report = run_design_loop(_case("GC-06_cheap_but_fails.json"), budget=12)
    accepted = [it for it in report["iterations"] if it["accepted_case_id"]]
    assert report["lineage"][0] == report["seed"]["case_id"]
    assert report["lineage"][1:] == [it["accepted_case_id"] for it in accepted]
    for previous, it in zip(report["lineage"], accepted):
        assert it["from_case_id"] == previous
    provenance = report["final"]["design_state"]["provenance"]
    assert provenance["parent_candidate_id"] == report["lineage"][-2]
    assert provenance["generation_action"] in {"DESIGN_LOOP_REPAIR", "DESIGN_LOOP_TRIM"}
    # Mỗi nước đi chỉ đổi đúng MỘT biến.
    for it in accepted:
        move = _accepted_probe(it)["move"]
        before = next(p for p in [report["seed"]] + [q for j in report["iterations"] for q in j["probes"]]
                      if p["case_id"] == it["from_case_id"])
        diff = {k for k in before["gene"] if before["gene"][k] != _accepted_probe(it)["gene"][k]}
        assert diff == {move["variable"]}


def test_geometry_invalid_seed_costs_no_solver_until_layout_is_clean():
    report = run_design_loop(_case("GC-02_geometry_invalid.json"), budget=20)
    _validate(report)
    assert report["seed"]["status"] == "GEOMETRY_INVALID"
    assert report["seed"]["solver_call_index"] is None
    assert report["seed"]["stage_label"] == "L0_INVALID"
    it1 = report["iterations"][0]
    assert it1["phase"] == "REPAIR" and it1["from_stage"] == "L0_INVALID"
    move = _accepted_probe(it1)["move"]
    assert (move["variable"], move["proposed"], move["rule_id"]) == ("girder_spacing_mm", 2200, "GEOM-001")
    assert _accepted_probe(it1)["solver_call_index"] == 1
    assert report["counters"]["loop"]["probes_l0_rejected"] == 1
    assert report["final"]["feasible"]


def test_trim_never_accepts_infeasible_and_cost_decreases_along_lineage():
    report = run_design_loop(_case("GC-07_pass_but_expensive.json"), budget=60)
    _validate(report)
    assert report["seed"]["feasible"]
    assert all(it["phase"] == "TRIM" for it in report["iterations"])
    costs = [report["seed"]["objectives"]["relative_cost"]]
    for it in report["iterations"]:
        for probe in it["probes"]:
            if probe["outcome"] == "ACCEPTED":
                assert probe["feasible"] and probe["max_utilization"] <= 1.0
                costs.append(probe["objectives"]["relative_cost"])
            else:
                assert probe["outcome"] in {"REJECTED_INFEASIBLE", "REJECTED_OVER_TARGET",
                                            "REJECTED_INVALID", "SOLVER_FAILED"}
                if probe["outcome"] == "REJECTED_INFEASIBLE":
                    assert not probe["feasible"]
        # Ứng viên TRIM luôn được xếp theo objective giải tích tăng dần.
        cheap = [c["cheap_objective"] for c in it["candidates"]]
        assert cheap == sorted(cheap)
    assert all(later < earlier for earlier, later in zip(costs, costs[1:]))
    assert report["termination"]["reason"] in {"CONVERGED", "BUDGET_EXHAUSTED"}


def test_utilization_target_is_enforced_in_both_phases():
    report = run_design_loop(_case("GC-01_standard_pass.json"), budget=40,
                             policy=LoopPolicy(utilization_target=0.85))
    _validate(report)
    seed = report["seed"]
    assert seed["feasible"] and seed["max_utilization"] > 0.85
    assert seed["stage_label"] == "FEASIBLE_OVER_TARGET"
    first = report["iterations"][0]
    assert first["phase"] == "REPAIR"
    # Vi phạm tổng hợp: mọi ứng viên gắn với một rule L1 thật, không có rule bịa.
    assert {c["rule_id"] for c in first["candidates"]} <= {"STR-001", "STR-002", "SERV-001",
                                                            "SERV-002", "MODEL-001"}
    final = report["final"]
    assert final["feasible"] and final["meets_target"]
    assert final["max_utilization"] <= 0.85
    assert final["rule_utilizations"] and max(final["rule_utilizations"].values()) <= 0.85 + 2e-3
    for it in report["iterations"]:
        if it["phase"] == "TRIM":
            for probe in it["probes"]:
                if probe["outcome"] == "ACCEPTED":
                    assert probe["max_utilization"] <= 0.85
                elif probe["feasible"]:
                    assert probe["outcome"] == "REJECTED_OVER_TARGET"


def test_trim_order_recent_reject_last_saves_budget_without_changing_convergence():
    seed = _case("GC-06_cheap_but_fails.json")
    baseline = run_design_loop(seed, budget=60, policy=LoopPolicy(trim_order="cheapest_first"))
    deferred = run_design_loop(seed, budget=60, policy=LoopPolicy(trim_order="recent_reject_last"))
    for report in (baseline, deferred):
        _validate(report)
        assert report["termination"]["reason"] == "CONVERGED"
        assert report["final"]["feasible"]
    assert deferred["counters"]["evaluator"]["solver_calls"] < baseline["counters"]["evaluator"]["solver_calls"]
    # Nước bị bác chỉ bị đẩy xuống cuối, KHÔNG bị loại: vòng cuối vẫn thử hết.
    last = deferred["iterations"][-1]
    assert last["accepted_case_id"] is None and last["unprobed_candidates"] == 0


def test_cheapest_first_policy_orders_repair_candidates_by_cheap_objective():
    report = run_design_loop(_case("GC-03_capacity_fail.json"), budget=6,
                             policy=LoopPolicy(move_policy="cheapest_first"))
    _validate(report)
    for it in report["iterations"]:
        if it["phase"] != "REPAIR":
            continue
        cheap = [c["cheap_objective"] for c in it["candidates"] if c["cheap_objective"] is not None]
        assert cheap == sorted(cheap)
        nones = [c["cheap_objective"] is None for c in it["candidates"]]
        assert nones == sorted(nones)  # None (L0 chặn) luôn nằm cuối


def test_deterministic_report_byte_for_byte():
    seed = _case("GC-03_capacity_fail.json")
    a = run_design_loop(seed, budget=20)
    b = run_design_loop(seed, budget=20)
    assert a == b
    assert json.dumps(a, sort_keys=True) == json.dumps(b, sort_keys=True)


# --------------------------------------------------------------- dừng & fail-closed
def test_budget_zero_and_one():
    seed = _case("GC-06_cheap_but_fails.json")
    zero = run_design_loop(seed, budget=0)
    _validate(zero)
    assert zero["termination"]["reason"] == "BUDGET_EXHAUSTED"
    assert zero["seed"]["status"] == "NOT_EVALUATED" and zero["final"] is None
    assert zero["counters"]["evaluator"]["solver_calls"] == 0 and zero["claim_level"] == "IDEA"

    one = run_design_loop(seed, budget=1)
    _validate(one)
    assert one["termination"]["reason"] == "BUDGET_EXHAUSTED"
    assert one["counters"]["evaluator"]["solver_calls"] == 1
    assert one["iterations"] == [] and one["final"]["case_id"] == one["seed"]["case_id"]
    assert one["claim_level"] == "IDEA"  # seed GC-06 infeasible


def test_max_iterations_caps_accepted_moves():
    report = run_design_loop(_case("GC-06_cheap_but_fails.json"), budget=40,
                             policy=LoopPolicy(max_iterations=1))
    _validate(report)
    assert report["termination"]["reason"] == "MAX_ITERATIONS"
    assert report["counters"]["loop"]["accepted_moves"] == 1
    assert len(report["lineage"]) == 2


def test_trim_disabled_stops_at_first_acceptable_design():
    report = run_design_loop(_case("GC-06_cheap_but_fails.json"), budget=40,
                             policy=LoopPolicy(trim_enabled=False))
    _validate(report)
    assert report["termination"]["reason"] == "CONVERGED"
    assert all(it["phase"] == "REPAIR" for it in report["iterations"])
    assert report["final"]["gene"]["prestress_layout_id"] == "PT-46"


def test_trim_probe_limit_is_reported_honestly():
    report = run_design_loop(_case("GC-07_pass_but_expensive.json"), budget=60,
                             policy=LoopPolicy(max_trim_probes=1))
    _validate(report)
    assert all(len(it["probes"]) <= 1 for it in report["iterations"])
    assert report["termination"]["reason"] in {"TRIM_PROBE_LIMIT", "BUDGET_EXHAUSTED"}
    if report["termination"]["reason"] == "TRIM_PROBE_LIMIT":
        assert report["iterations"][-1]["unprobed_candidates"] >= 1


def test_schema_invalid_seed_is_rejected_before_any_solver_call():
    seed = _case("GC-01_standard_pass.json")
    seed["materials"]["girder_concrete_id"] = "C-KHONG-TON-TAI"
    report = run_design_loop(seed, budget=10)
    _validate(report)
    assert report["termination"]["reason"] == "SEED_REJECTED"
    assert report["seed"]["status"] == "SCHEMA_INVALID"
    assert report["counters"]["evaluator"]["solver_calls"] == 0
    assert report["final"] is None and report["lineage"] == []
    assert report["claim_level"] == "IDEA"


def test_seed_with_wrong_project_inputs_is_not_silently_rebuilt():
    seed = _case("GC-01_standard_pass.json")
    seed["project_inputs"]["span_length_m"] = 40.0
    report = run_design_loop(seed, budget=10)
    assert report["termination"]["reason"] == "SEED_REJECTED"
    assert "span_length_m" in report["termination"]["message"]
    assert report["counters"]["evaluator"]["solver_calls"] == 0


def test_test_only_fixture_seed_is_rejected_without_solver():
    report = run_design_loop(_case("GC-05_solver_failure.json"), budget=10)
    _validate(report)
    assert report["termination"]["reason"] == "SEED_REJECTED"
    assert report["counters"]["evaluator"]["solver_calls"] == 0
    assert report["final"] is None


def test_grammar_mismatch_is_rejected():
    report = run_design_loop(_case("GC-01_standard_pass.json"), budget=5,
                             grammar_id="super_t_parametric_v2")
    assert report["termination"]["reason"] == "SEED_REJECTED"
    assert report["counters"]["evaluator"]["solver_calls"] == 0


def test_solver_failure_at_seed_stops_loop(monkeypatch):
    def boom(state, geom):
        raise SolverError("kỳ dị giả lập")
    monkeypatch.setattr(evaluate_module, "run_analysis", boom)
    report = run_design_loop(_case("GC-01_standard_pass.json"), budget=10)
    _validate(report)
    assert report["termination"]["reason"] == "SOLVER_FAILED"
    assert report["seed"]["status"] == "SOLVER_FAILED"
    assert report["iterations"] == [] and report["final"] is None
    assert report["counters"]["loop"]["solver_failures"] == 1
    assert report["claim_level"] == "IDEA"


def test_solver_failure_on_a_probe_is_discarded_not_accepted(monkeypatch):
    real = evaluate_module.run_analysis

    def flaky(state, geom):
        if state["design_variables"]["prestress_layout_id"] == "PT-42":
            raise SolverError("kỳ dị giả lập cho PT-42")
        return real(state, geom)
    monkeypatch.setattr(evaluate_module, "run_analysis", flaky)
    report = run_design_loop(_case("GC-06_cheap_but_fails.json"), budget=12)
    _validate(report)
    failed = [p for it in report["iterations"] for p in it["probes"] if p["outcome"] == "SOLVER_FAILED"]
    assert failed and all(p["status"] == "SOLVER_FAILED" for p in failed)
    assert all(p["case_id"] not in report["lineage"] for p in failed)
    assert report["counters"]["loop"]["solver_failures"] == len(failed)
    assert any("KC-007" in note for note in report["advisories"])
    # Vòng lặp vẫn đi tiếp bằng ứng viên khác của cùng chẩn đoán.
    assert report["iterations"][0]["accepted_case_id"] is not None


def test_no_improving_repair_terminates_without_loop(monkeypatch):
    monkeypatch.setattr(loop_module, "suggest_repairs", lambda *args, **kwargs: [])
    report = run_design_loop(_case("GC-06_cheap_but_fails.json"), budget=10)
    _validate(report)
    assert report["termination"]["reason"] == "NO_IMPROVING_REPAIR"
    assert report["iterations"][0]["candidates"] == [] and report["iterations"][0]["probes"] == []
    assert report["final"]["case_id"] == report["seed"]["case_id"]
    assert not report["final"]["feasible"] and report["claim_level"] == "IDEA"
    assert report["counters"]["evaluator"]["solver_calls"] == 1


def test_invalid_policy_and_budget_are_rejected():
    seed = _case("GC-01_standard_pass.json")
    with pytest.raises(DesignLoopError):
        run_design_loop(seed, budget=5, policy=LoopPolicy(utilization_target=1.2))
    with pytest.raises(DesignLoopError):
        run_design_loop(seed, budget=5, policy=LoopPolicy(utilization_target=0.0))
    with pytest.raises(DesignLoopError):
        run_design_loop(seed, budget=5, policy=LoopPolicy(move_policy="random"))
    with pytest.raises(DesignLoopError):
        run_design_loop(seed, budget=5, policy=LoopPolicy(trim_order="anything"))
    with pytest.raises(DesignLoopError):
        run_design_loop(seed, budget=5, policy=LoopPolicy(objective_key="profit"))
    with pytest.raises(DesignLoopError):
        run_design_loop(seed, budget=-1)
    with pytest.raises(DesignLoopError):
        run_design_loop("not a state", budget=1)


# --------------------------------------------------------------- audit & contract
def test_component_audit_hands_over_l1_evidence_fail_closed():
    report = run_design_loop(_case("GC-06_cheap_but_fails.json"), budget=30)
    audit = report["component_audit"]
    assert audit is not None and audit["status"] == "BLOCKED"
    assert audit["alters_evaluation_verdict"] is False
    assert audit["candidate_id"] == report["final"]["case_id"]
    girder = next(c for c in audit["components"] if c["component_id"] == "G1")
    checks = {c["check_id"]: c for c in girder["checks"]}
    for check_id in ("FLEXURE_STRENGTH", "SERVICE_STRESS", "DEFLECTION"):
        assert checks[check_id]["status"] == "PASS"
        assert checks[check_id]["evidence"]["fidelity"] == "L1"
        assert 0.0 <= checks[check_id]["utilization"] <= 1.0
    for check_id in ("SHEAR_TORSION", "FATIGUE", "STABILITY"):
        assert checks[check_id]["status"] == "NOT_EVALUATED"
        assert checks[check_id]["evidence"] is None
    assert "xoắn" in checks["SHEAR_TORSION"]["message"]
    kinds = {c["kind"] for c in audit["components"]}
    assert {"LONGITUDINAL_GIRDER", "DECK_SLAB", "PRESTRESSING_SYSTEM"} <= kinds
    codes = {b["code"] for b in audit["blocking_reasons"]}
    assert codes == {"MISSING_HARD_CHECK_EVIDENCE"}
    assert {p["kind"] for p in audit["proposals"]} == {"EVIDENCE_REQUEST"}
    assert all(p["claim"] == "UNVERIFIED_PROPOSAL" for p in audit["proposals"])
    # Bằng chứng khớp đúng record cuối (tái băm được).
    final_state = report["final"]["design_state"]
    fresh = evaluate_candidate(final_state)
    assert fresh["feasible"] and fresh["case_id"] == report["final"]["case_id"]


def test_component_audit_is_null_when_final_never_reached_solver(monkeypatch):
    # Seed L0-invalid không tiêu solver; với budget 1 nước sửa đầu tiên vẫn chạy
    # được. Muốn phương án cuối chưa qua solver phải chặn tầng chẩn đoán.
    monkeypatch.setattr(loop_module, "suggest_repairs", lambda *args, **kwargs: [])
    report = run_design_loop(_case("GC-02_geometry_invalid.json"), budget=1)
    _validate(report)
    assert report["termination"]["reason"] == "NO_IMPROVING_REPAIR"
    assert report["final"]["status"] == "GEOMETRY_INVALID"
    assert report["counters"]["evaluator"]["solver_calls"] == 0
    assert report["component_audit"] is None


def test_unknown_grammar_seed_yields_rejected_report_not_exception():
    seed = _case("GC-01_standard_pass.json")
    seed["family"] = "khong_ton_tai"
    report = run_design_loop(seed, budget=2)
    _validate(report)
    assert report["termination"]["reason"] == "SEED_REJECTED"
    assert report["grammar_version"] == "n/a"
    assert report["counters"]["evaluator"]["solver_calls"] == 0


def test_report_pins_basis_and_source_digests(tmp_path, monkeypatch):
    report = run_design_loop(_case("GC-01_standard_pass.json"), budget=2)
    basis_path = REPO_ROOT / "docs" / "design_basis" / "design_loop_basis.json"
    assert report["basis"]["sha256"] == hashlib.sha256(basis_path.read_bytes()).hexdigest()
    source = REPO_ROOT / "bridge_evolution" / "design_loop.py"
    assert report["source_digests"] == [{
        "path": "bridge_evolution/design_loop.py",
        "sha256": hashlib.sha256(source.read_bytes()).hexdigest(),
    }]
    assert load_loop_basis()["default_policy"] == report["policy"]

    tampered = json.loads(basis_path.read_text(encoding="utf-8"))
    tampered["algorithm_version"] = "design-loop/9.9.9"
    fake = tmp_path / "basis.json"
    fake.write_text(json.dumps(tampered), encoding="utf-8")
    monkeypatch.setattr(loop_module, "_BASIS_PATH", fake)
    with pytest.raises(DesignLoopError, match="drift"):
        run_design_loop(_case("GC-01_standard_pass.json"), budget=1)


def test_progress_ladder_and_rule_utilizations():
    seed = _case("GC-06_cheap_but_fails.json")
    result = evaluate_candidate(seed)
    utils = rule_utilizations(result["responses"])
    assert set(utils) >= {"STR-001", "STR-002", "SERV-001", "SERV-002"}
    assert utils["SERV-001"] == pytest.approx(result["responses"]["max_utilization"], abs=2e-3)
    assert "MODEL-001" not in utils
    assert rule_utilizations(None) == {} and rule_utilizations({"x": 1}) == {}

    infeasible = {"status": "SUCCESS", "feasible": False, "cv": 1.3, "max_utilization": 2.3}
    feasible_over = {"status": "SUCCESS", "feasible": True, "cv": 0.0, "max_utilization": 0.95}
    acceptable = {"status": "SUCCESS", "feasible": True, "cv": 0.0, "max_utilization": 0.80}
    l0 = {"status": "GEOMETRY_INVALID", "feasible": False, "cv": 1.0}
    failed = {"status": "SOLVER_FAILED", "feasible": False, "cv": 1.0}
    assert [progress_stage(r, 0.9) for r in (failed, l0, infeasible, feasible_over, acceptable)] == [0, 1, 2, 3, 4]
    assert progress_key(acceptable, 0.9) > progress_key(feasible_over, 0.9) > progress_key(infeasible, 0.9)
    assert progress_key(dict(infeasible, cv=0.5), 0.9) > progress_key(infeasible, 0.9)
    assert progress_stage(acceptable, 0.8) == 4 and progress_stage(acceptable, 0.79) == 3


def test_grammar_v2_anchor_smoke():
    registry = load_applicability_registry()
    gene = registry["families"]["super_t_parametric_v2"]["anchor_gene"]
    seed = state_from_gene(dict(gene), grammar_id="super_t_parametric_v2")
    report = run_design_loop(seed, budget=6)
    _validate(report)
    assert report["grammar_id"] == "super_t_parametric_v2"
    assert report["seed"]["status"] in {"SUCCESS", "GEOMETRY_INVALID"}
    assert len(report["seed"]["gene"]) == 14
    assert report["counters"]["evaluator"]["solver_calls"] <= 6


def test_cli_writes_report_and_returns_feasibility_code(tmp_path, capsys):
    out = tmp_path / "report.json"
    code = main([str(CASES / "GC-06_cheap_but_fails.json"), "--budget", "8",
                 "--trim-order", "recent_reject_last", "--out", str(out)])
    assert code == 0
    printed = json.loads(capsys.readouterr().out)
    report = json.loads(out.read_text(encoding="utf-8"))
    _validate(report)
    assert printed == summarize(report)
    assert printed["final_feasible"] is True

    seed = tmp_path / "bad.json"
    bad = _case("GC-01_standard_pass.json")
    bad["family"] = "khong_ton_tai"
    seed.write_text(json.dumps(bad), encoding="utf-8")
    assert main([str(seed), "--budget", "2"]) == 1  # SEED_REJECTED → không khả thi
    assert main([str(seed), "--budget", "2", "--target", "1.5"]) == 2  # policy sai
