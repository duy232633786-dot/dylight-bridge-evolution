[build-system]
requires = ["setuptools>=75"]
build-backend = "setuptools.build_meta"

[project]
name = "dylight-bridge-evolution"
version = "0.8.0"
description = "Safety-constrained research environment for preliminary Super-T bridge optimization"
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
  "jsonschema>=4.20,<5",
  "numpy>=1.26,<3",
  "scikit-learn>=1.4,<2",
]

[project.optional-dependencies]
optimization = ["pymoo>=0.6.2,<0.7"]
section-fea = [
  "shapely>=2.1.2,<3",
  "sectionproperties>=3.10.2,<4",
]
ifc = [
  "ifcopenshell>=0.8.5,<0.9",
  "shapely>=2.1.2,<3",
]
all = [
  "pymoo>=0.6.2,<0.7",
  "shapely>=2.1.2,<3",
  "sectionproperties>=3.10.2,<4",
  "ifcopenshell>=0.8.5,<0.9",
]
dev = [
  "pytest>=8,<10",
  "pypdf>=6,<7",
  "pymoo>=0.6.2,<0.7",
  "shapely>=2.1.2,<3",
  "sectionproperties>=3.10.2,<4",
  "ifcopenshell>=0.8.5,<0.9",
]
pdf = ["pypdf>=6,<7"]

[project.scripts]
dylight-bridge = "bridge_evolution.cli:main"

[tool.setuptools]
include-package-data = true
packages = [
  "bridge_evolution",
  "bridge_evolution.analysis",
  "bridge_evolution.bim",
  "bridge_evolution.collaboration",
  "bridge_evolution.durability",
  "bridge_evolution.fe_adapter",
  "bridge_evolution.knowledge",
  "bridge_evolution.optimization",
  "bridge_evolution.rl_env",
  "bridge_evolution.surrogate",
  "bridge_evolution.verifier",
  "dylight_contracts",
  "dylight_catalogs",
  "dylight_grammar",
  "dylight_knowledge_cards",
  "dylight_knowledge_audits",
]

[tool.setuptools.package-dir]
dylight_contracts = "contracts"
dylight_catalogs = "catalogs"
dylight_grammar = "bridge_grammar"
dylight_knowledge_cards = "knowledge/cards"
dylight_knowledge_audits = "knowledge/audits"

[tool.setuptools.package-data]
dylight_contracts = ["*.json"]
dylight_catalogs = ["*.json"]
dylight_grammar = ["*.json"]
dylight_knowledge_cards = ["*.json"]
dylight_knowledge_audits = ["*.json"]
"bridge_evolution.knowledge" = ["*.json"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"
