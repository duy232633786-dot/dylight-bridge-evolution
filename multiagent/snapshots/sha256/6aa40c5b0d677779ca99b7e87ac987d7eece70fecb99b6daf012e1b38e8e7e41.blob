"""Kiểm chứng engine tuổi thọ (BRD-026 — bridge_evolution/durability/).

Bốn lớp kiểm:
  1. TOÁN HỌC — đối chiếu giá trị tính tay / tính chất giải tích (erf, S-N, Miner).
  2. ĐƠN ĐIỆU — cover tăng → tuổi thọ tăng; fck tăng → tuổi thọ tăng; Δσ tăng → N giảm.
  3. CHỐNG LỆNH ĐẦU VÀO — tham số lạ raise, không bịa mặc định.
  4. KẾ HOẠCH — mốc kiểm tra đúng cấu trúc, LCC chọn được chu kỳ, advisory luôn True.
"""
import math

import pytest

from bridge_evolution.durability import (
    carbonation_coefficient,
    carbonation_initiation_years,
    chloride_concentration,
    chloride_initiation_years,
    cycles_to_failure,
    fatigue_life_years,
    inspection_plan,
    miner_damage,
    optimal_inspection_interval,
    remaining_service_life,
    service_life_years,
)

# ---------------------------------------------------------------- carbonation
def test_carbonation_known_value_and_units():
    # C30, RH70, outdoor sheltered → k = 4.0 (điểm chuẩn tham chiếu)
    assert carbonation_coefficient(30.0, 70.0, "outdoor_sheltered") == pytest.approx(4.0)
    # cover 40mm, k=4 → t = (40/4)^2 = 100 năm
    assert carbonation_initiation_years(40.0, 30.0, 70.0, "outdoor_sheltered") \
        == pytest.approx(100.0)


def test_carbonation_monotonic():
    t_prev = 0.0
    for cover in (20, 25, 30, 40, 50):
        t = carbonation_initiation_years(cover, 30.0, 70.0, "outdoor_sheltered")
        assert t > t_prev
        t_prev = t
    # Bê tông mạnh hơn → tuổi thọ cao hơn
    assert carbonation_initiation_years(40, 50) > carbonation_initiation_years(40, 30)


def test_carbonation_rejects_bad_input():
    with pytest.raises(ValueError):
        carbonation_coefficient(-5)
    with pytest.raises(ValueError):
        carbonation_coefficient(30, 120)
    with pytest.raises(ValueError):
        carbonation_coefficient(30, 70, "underwater_lava")
    with pytest.raises(ValueError):
        carbonation_initiation_years(0)


# ---------------------------------------------------------------- chloride
def test_chloride_erf_properties():
    # t → ∞: C → Cs tại mọi độ sâu (erf(0)=1 khi D·t → ∞ so với x²)
    assert chloride_concentration(10, 5000, 4.0) == pytest.approx(4.0, abs=0.05)
    # t = 0 → 0
    assert chloride_concentration(10, 0, 4.0) == 0.0
    # Sâu hơn → nồng độ thấp hơn (tại cùng t)
    c_shallow = chloride_concentration(20, 30, 4.0)
    c_deep = chloride_concentration(60, 30, 4.0)
    assert c_shallow > c_deep > 0


def test_chloride_initiation_monotonic_and_finite():
    t_thin = chloride_initiation_years(30, 4.0)
    t_thick = chloride_initiation_years(60, 4.0)
    assert 0 < t_thin < t_thick
    # Cs sát C_crit → thời gian dài; Cs ≤ C_crit → lỗi
    with pytest.raises(ValueError):
        chloride_initiation_years(40, 0.5, ccrit_percent=0.6)


# ---------------------------------------------------------------- fatigue
def test_sn_reference_point_and_slope():
    # Điểm chuẩn hóa EN 1993-1-9: tại Δσ = Δσ_C → N = 2e6
    assert cycles_to_failure(71.0, 71.0) == pytest.approx(2.0e6)
    # m=3: giảm Δσ còn một nửa → N ×8
    assert cycles_to_failure(35.5, 71.0) == pytest.approx(8 * 2.0e6)
    with pytest.raises(ValueError):
        cycles_to_failure(10, -1)


def test_miner_damage_sums_to_one_at_failure():
    # 2e6 chu kỳ @71MPa → D = 1.0
    assert miner_damage([(2.0e6, 71.0)]) == pytest.approx(1.0)
    # Hai mức cộng dồn
    d = miner_damage([(1.0e6, 71.0), (8.0e6, 35.5)])
    assert d == pytest.approx(0.5 + 0.5)
    # Tuổi thọ = 1/D_per_year
    life = fatigue_life_years([(1.0e5, 71.0)])
    assert life == pytest.approx(20.0)
    assert fatigue_life_years([]) == float("inf")


# ---------------------------------------------------------------- service life
def test_service_life_sum_and_monotonic():
    t_carb = service_life_years(40, "carbonation", fck_MPa=30)
    assert t_carb == pytest.approx(100 + 8)  # initiation + propagation mặc định
    assert service_life_years(50, "carbonation") > service_life_years(30, "carbonation")
    with pytest.raises(ValueError):
        service_life_years(40, "sulfate_attack")


def test_remaining_life_and_condition_factor():
    r = remaining_service_life(30, cover_mm=40, mechanism="carbonation",
                               condition_state=2)
    assert r["advisory"] is True
    assert r["theoretical_life_years"] == pytest.approx(108.0)
    assert r["adjusted_life_years"] == pytest.approx(108.0 * 0.9)
    assert r["remaining_life_years"] == pytest.approx(108.0 * 0.9 - 30.0)
    # State xấu hơn → còn lại ít hơn
    r4 = remaining_service_life(30, cover_mm=40, condition_state=4)
    assert r4["remaining_life_years"] < r["remaining_life_years"]
    with pytest.raises(ValueError):
        remaining_service_life(30, 40, condition_state=5)


# ---------------------------------------------------------------- maintenance
def test_inspection_plan_structure():
    plan = inspection_plan(t_initiate_years=100.0, design_life_years=100.0)
    assert plan["advisory"] is True
    # Mốc đầu = min(10, 0.5·100) = 10
    assert plan["first_inspection_year"] == pytest.approx(10.0)
    years = plan["inspection_years"]
    assert years[0] == pytest.approx(10.0)
    # Đơn điệu tăng, không vượt tuổi thọ, có mốc quanh t_initiate (dày hơn)
    assert all(b > a for a, b in zip(years, years[1:]))
    assert max(years) <= 100.0
    assert any(abs(y - 100.0) < 12.0 for y in years)
    with pytest.raises(ValueError):
        inspection_plan(0)


def test_optimal_interval_prefers_reasonable_value():
    res = optimal_inspection_interval(
        t_initiate_years=50.0, cost_inspection=1.0, cost_late_detection=50.0)
    assert res["advisory"] is True
    assert 2.0 <= res["optimal_interval_years"] <= 10.0
    # Chi phí muộn lớn → chu kỳ ngắn hơn so với chi phí muộn nhỏ
    res_risky = optimal_inspection_interval(50.0, 1.0, 5000.0)
    assert res_risky["optimal_interval_years"] <= res["optimal_interval_years"]
