{
  "schema_version": "2.0",
  "reference": {
    "id": "OPENSEES_FRAME_2D_REFERENCE_HARDENED",
    "version": "opensees-frame-reference/0.2.0"
  },
  "claim_ceiling": "IDEA",
  "design_verdict_authority": "NONE",
  "technical_scope": "HARDENED_LINEAR_2D_CODE_VERIFICATION_NO_L2_OR_DESIGN_VERDICT",
  "units": {
    "length": "m",
    "force": "kN",
    "moment": "kN_m",
    "elastic_modulus": "GPa",
    "area": "m2",
    "inertia": "m4"
  },
  "formulations": {
    "FRAME_2D": "OpenSees elasticBeamColumn 2D, Euler-Bernoulli, Linear geometric transformation",
    "TRUSS_2D": "OpenSees Truss with Elastic uniaxial material, small displacement",
    "TRUSS_2D_localForce_contract": "For the pinned OpenSees 3.8.0 Windows backend, localForce is treated as [N_i, V_i=0, M_i=0, N_j=-N_i, V_j=0, M_j=0] in the element local frame; this is runtime-asserted for every truss and independently challenged by an inclined two-bar analytical benchmark.",
    "analysis": "Static Linear, one LoadControl step per clean domain",
    "truss_rotation_policy": "Fix rz at every node incident only to TRUSS_2D because rotation is outside the truss formulation; every such implicit constraint is enumerated and its Mz reaction must remain within the preregistered zero tolerance."
  },
  "minimum_element_length_m": 1e-09,
  "artificial_rotation_reaction_absolute_kNm": 1e-08,
  "truss_response_tolerances": {
    "force_absolute_kN": 1e-08,
    "force_relative": 1e-08,
    "moment_absolute_kNm": 1e-08
  },
  "comparison_tolerances": {
    "displacement_absolute_m": 1e-10,
    "displacement_relative": 1e-06,
    "rotation_absolute_rad": 1e-12,
    "rotation_relative": 1e-06,
    "force_absolute_kN": 1e-06,
    "force_relative": 1e-06,
    "moment_absolute_kNm": 1e-06,
    "moment_relative": 1e-06,
    "equilibrium_force_absolute_kN": 1e-06,
    "equilibrium_force_relative": 1e-08,
    "equilibrium_moment_absolute_kNm": 1e-06,
    "equilibrium_moment_relative": 1e-08
  },
  "expected_backend_identity": {
    "name": "OpenSees",
    "engine_version": "3.8.0",
    "package_name": "openseespywin",
    "package_version": "3.8.0.0",
    "python_version": "3.12.13",
    "python_implementation": "CPython",
    "python_executable_sha256": "d8e3f0adf246db00358c0c4ed349cf714898178f9558fb0e944f79f5c07f8eaa",
    "binary_owner_module": "openseespywin.opensees",
    "binary_file_name": "opensees.pyd",
    "binary_sha256": "25ba42e1672526137d765d9c3631d1403e091f54f5afcdb9242f9243c63c3a96"
  },
  "benchmark_inputs": {
    "inclined_two_bar_truss": {
      "half_span_m": 3.0,
      "height_m": 4.0,
      "elastic_modulus_GPa": 200.0,
      "area_m2": 0.01,
      "inertia_m4": 0.001,
      "apex_force_kN": -80.0
    }
  },
  "analytical_expectations": {
    "BRD044-ANALYTICAL-AXIAL": {
      "equation_id": "AXIAL_BAR_DELTA_PL_OVER_EA",
      "checks": [
        {"response_kind": "NODE_DISPLACEMENT", "load_case_id": "LC1", "entity_id": "N2", "component": "ux_m", "expected_value": 0.00005, "absolute_tolerance": 1e-11, "relative_tolerance": 1e-08},
        {"response_kind": "SUPPORT_REACTION", "load_case_id": "LC1", "entity_id": "N1", "component": "fx_kN", "expected_value": -100.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08},
        {"response_kind": "ELEMENT_END_FORCE", "load_case_id": "LC1", "entity_id": "E1", "component": "axial_i_kN", "expected_value": -100.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08},
        {"response_kind": "ELEMENT_END_FORCE", "load_case_id": "LC1", "entity_id": "E1", "component": "axial_j_kN", "expected_value": 100.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08}
      ]
    },
    "BRD044-ANALYTICAL-CANTILEVER": {
      "equation_id": "EULER_BERNOULLI_CANTILEVER_TIP_LOAD",
      "checks": [
        {"response_kind": "NODE_DISPLACEMENT", "load_case_id": "LC1", "entity_id": "N2", "component": "uy_m", "expected_value": -0.000225, "absolute_tolerance": 1e-11, "relative_tolerance": 1e-08},
        {"response_kind": "NODE_DISPLACEMENT", "load_case_id": "LC1", "entity_id": "N2", "component": "rz_rad", "expected_value": -0.0001125, "absolute_tolerance": 1e-11, "relative_tolerance": 1e-08},
        {"response_kind": "SUPPORT_REACTION", "load_case_id": "LC1", "entity_id": "N1", "component": "fy_kN", "expected_value": 10.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08},
        {"response_kind": "SUPPORT_REACTION", "load_case_id": "LC1", "entity_id": "N1", "component": "mz_kNm", "expected_value": 30.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08}
      ]
    },
    "BRD044-ANALYTICAL-SIMPLE-BEAM": {
      "equation_id": "EULER_BERNOULLI_SIMPLY_SUPPORTED_MIDSPAN_POINT_LOAD",
      "checks": [
        {"response_kind": "NODE_DISPLACEMENT", "load_case_id": "LC1", "entity_id": "M", "component": "uy_m", "expected_value": -0.0010416666666666667, "absolute_tolerance": 1e-11, "relative_tolerance": 1e-08},
        {"response_kind": "SUPPORT_REACTION", "load_case_id": "LC1", "entity_id": "A", "component": "fy_kN", "expected_value": 10.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08},
        {"response_kind": "SUPPORT_REACTION", "load_case_id": "LC1", "entity_id": "B", "component": "fy_kN", "expected_value": 10.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08},
        {"response_kind": "MAX_ABS_ELEMENT_MOMENT", "load_case_id": "LC1", "entity_id": "ALL", "component": "max_abs_moment_kNm", "expected_value": 50.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08}
      ]
    },
    "BRD045-ANALYTICAL-INCLINED-TRUSS": {
      "equation_id": "SYMMETRIC_TWO_BAR_TRUSS_DELTA_PL_OVER_2EA_SIN2_THETA",
      "checks": [
        {"response_kind": "NODE_DISPLACEMENT", "load_case_id": "LC1", "entity_id": "N3", "component": "ux_m", "expected_value": 0.0, "absolute_tolerance": 1e-11, "relative_tolerance": 1e-08},
        {"response_kind": "NODE_DISPLACEMENT", "load_case_id": "LC1", "entity_id": "N3", "component": "uy_m", "expected_value": -0.00015625, "absolute_tolerance": 1e-11, "relative_tolerance": 1e-08},
        {"response_kind": "SUPPORT_REACTION", "load_case_id": "LC1", "entity_id": "N1", "component": "fx_kN", "expected_value": 30.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08},
        {"response_kind": "SUPPORT_REACTION", "load_case_id": "LC1", "entity_id": "N1", "component": "fy_kN", "expected_value": 40.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08},
        {"response_kind": "SUPPORT_REACTION", "load_case_id": "LC1", "entity_id": "N2", "component": "fx_kN", "expected_value": -30.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08},
        {"response_kind": "SUPPORT_REACTION", "load_case_id": "LC1", "entity_id": "N2", "component": "fy_kN", "expected_value": 40.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08},
        {"response_kind": "ELEMENT_END_FORCE", "load_case_id": "LC1", "entity_id": "E1", "component": "axial_i_kN", "expected_value": 50.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08},
        {"response_kind": "ELEMENT_END_FORCE", "load_case_id": "LC1", "entity_id": "E1", "component": "axial_j_kN", "expected_value": -50.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08},
        {"response_kind": "ELEMENT_END_FORCE", "load_case_id": "LC1", "entity_id": "E2", "component": "axial_i_kN", "expected_value": 50.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08},
        {"response_kind": "ELEMENT_END_FORCE", "load_case_id": "LC1", "entity_id": "E2", "component": "axial_j_kN", "expected_value": -50.0, "absolute_tolerance": 1e-08, "relative_tolerance": 1e-08}
      ]
    }
  },
