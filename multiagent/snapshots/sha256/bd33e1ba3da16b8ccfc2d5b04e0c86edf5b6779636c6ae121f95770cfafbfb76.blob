{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_brief.schema.json",
  "title": "BridgeLabResearchBrief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "brief_id", "created_at", "topic", "objectives",
    "constraints", "requested_by", "autonomy_mode", "claim_ceiling",
    "budget", "human_gates", "knowledge_sink"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "brief_id": {"type": "string", "pattern": "^RND-[0-9]{8}-[a-f0-9]{8}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "topic": {"type": "string", "minLength": 10, "maxLength": 4000},
    "objectives": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 5, "maxLength": 1000}
    },
    "constraints": {
      "type": "array", "items": {"type": "string", "minLength": 3, "maxLength": 1000}
    },
    "requested_by": {"type": "string", "minLength": 2, "maxLength": 64},
    "autonomy_mode": {"enum": ["PLAN_ONLY", "DIGITAL_AUTO"]},
    "claim_ceiling": {"enum": ["IDEA", "SCREENED"]},
    "runtime_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structural_families", "runtime_domain"],
      "properties": {
        "structural_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}
        },
        "runtime_domain": {
          "enum": [
            "production_line_girder_l1",
            "production_l0_only",
            "experimental_arch_frame",
            "straight_prismatic_column"
          ]
        }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_tasks", "max_parallel", "max_retries", "task_timeout_seconds", "wall_time_seconds"],
      "properties": {
        "max_tasks": {"type": "integer", "minimum": 4, "maximum": 12},
        "max_parallel": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 3},
        "task_timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 14400},
        "wall_time_seconds": {"type": "integer", "minimum": 300, "maximum": 86400}
      }
    },
    "human_gates": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["G5", "G6", "G7", "EXTERNAL_WRITE", "TECHNICAL_RELEASE"]}
    },
    "knowledge_sink": {"const": "OBSIDIAN_AND_CANONICAL_JSON"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.1"}}
      },
      "then": {"required": ["runtime_scope"]}
    }
  ]
}
