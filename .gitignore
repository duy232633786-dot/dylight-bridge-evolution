# --------------------------------------------------------------------------
# Kết quả thí nghiệm
# --------------------------------------------------------------------------
# Nguyên tắc (docs/baseline_version_control_plan.md): KHÔNG hash vào handoff một
# artifact chưa được version-control. Trước đây cả thư mục experiments/results/*/
# bị loại, nên summary.md và oracle_comparison.md — đúng những file mà handoff
# BRD-009 đã hash — không thể tái dựng bytes gốc từ Git.
#
# Vì vậy: loại file NẶNG (history/proposals/solver_history dạng .jsonl và .csv,
# tổng ~13 GB), GIỮ LẠI artifact VĂN BẢN NHỎ (summary/manifest/pareto, mỗi file
# ~1–95 KB) vì đó là thứ được trích dẫn và được hash.
experiments/results/**
!experiments/results/
!experiments/results/.gitkeep
!experiments/results/*/
!experiments/results/*/summary.md
!experiments/results/*/summary.json
!experiments/results/*/manifest.json
!experiments/results/*/oracle_comparison.md
!experiments/results/*/pareto_*.json

# Artifact đánh giá từng phương án: sinh lại được từ state + seed, KHÔNG được
# hash vào handoff. Muốn trích dẫn thì chép sang đường dẫn có version-control.
artifacts/*/
!artifacts/.gitkeep

multiagent/.locks/*
multiagent/scratch/*
!multiagent/.locks/.gitkeep
!multiagent/scratch/.gitkeep

CLAUDE.local.md

# Thư mục scratch của các phiên lab (không phải artifact có hash)
.tmp/
# BRD-059 hash các file này trong handoff -> phải có trong git
!experiments/results/nsga2_operator_ab/runs.jsonl
!experiments/results/nsga2_operator_ab/pytest_full_suite_long_basetemp.log
!experiments/results/nsga2_operator_ab/pytest_rerun_short_basetemp.log
