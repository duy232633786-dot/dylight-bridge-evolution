{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provenance_correction.schema.json",
  "title": "BridgeLabProvenanceCorrectionHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "correction_id", "task_id", "incident_id", "agent_id", "role",
    "summary", "original_handoff_path", "original_handoff_sha256", "snapshot",
    "corrected_artifact", "verification_commands", "assumptions", "unresolved_risks",
    "supersedes_correction_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "correction_id": {"type": "string", "pattern": "^COR-(?:BRD-[0-9]{3}|RND-[a-f0-9]{8}-[0-9]{2})-[0-9]{3}$"},
    "task_id": {"type": "string", "pattern": "^(?:BRD-[0-9]{3}|RND-[a-f0-9]{8}-[0-9]{2})$"},
    "incident_id": {"type": "string", "pattern": "^INC-(?:BRD-[0-9]{3}|RND-[a-f0-9]{8}-[0-9]{2})-[0-9]{3}$"},
    "agent_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$"},
    "role": {"const": "evidence_safety_auditor"},
    "summary": {"type": "string", "minLength": 10},
    "original_handoff_path": {"type": "string", "pattern": "^multiagent/handoffs/.+\\.json$"},
    "original_handoff_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^multiagent/snapshots/sha256/[a-f0-9]{64}\\.blob$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "corrected_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "previous_sha256", "current_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "previous_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "current_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "verification_commands": {
      "type": "array", "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unresolved_risks": {"type": "array", "items": {"type": "string"}},
    "supersedes_correction_sha256": {
      "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"
    }
  }
}
