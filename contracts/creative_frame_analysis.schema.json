{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative_frame_analysis.schema.json",
  "title": "CreativeFrameF1Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "analysis_sha256",
    "adapter",
    "adapter_source_sha256",
    "adapter_source_digests",
    "claim_level",
    "design_verdict_authority",
    "technical_scope",
    "status",
    "candidate",
    "creative_technical_profile",
    "structural_profile",
    "frame_model",
    "frame_result",
    "manifest",
    "basis_hashes",
    "source_digests",
    "load_conservation",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "analysis_id": { "type": "string", "pattern": "^CFA-[0-9a-f]{16}$" },
    "analysis_sha256": { "$ref": "#/$defs/sha256" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "CREATIVE_ARCH_TO_FRAME_F1" },
        "version": { "const": "creative-frame-adapter/0.1.0" }
      }
    },
    "adapter_source_sha256": { "$ref": "#/$defs/sha256" },
    "adapter_source_digests": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/adapter_source_digest" }
    },
    "claim_level": { "const": "IDEA" },
    "design_verdict_authority": { "const": "NONE" },
    "technical_scope": { "const": "F0_CANDIDATE_TO_F1_LINEAR_MODEL_NO_DESIGN_VERDICT" },
    "status": {
      "enum": ["CONVERGED", "UNSTABLE_MODEL", "NUMERICAL_FAILURE", "MODEL_LIMIT_EXCEEDED"]
    },
    "candidate": { "type": "object" },
    "creative_technical_profile": { "type": "object" },
    "structural_profile": { "type": "object" },
    "frame_model": { "type": "object" },
    "frame_result": { "type": "object" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_sha256",
        "geometry_sha256",
        "candidate_profile_sha256",
        "structural_profile_sha256",
        "model_sha256",
        "frame_result_sha256"
      ],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^CS-[0-9a-f]{16}$" },
        "candidate_sha256": { "$ref": "#/$defs/sha256" },
        "geometry_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_profile_sha256": { "$ref": "#/$defs/sha256" },
        "structural_profile_sha256": { "$ref": "#/$defs/sha256" },
        "model_sha256": { "$ref": "#/$defs/sha256" },
        "frame_result_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "basis_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creative_domain_sha256", "adapter_basis_sha256", "frame_basis_sha256"],
      "properties": {
        "creative_domain_sha256": { "$ref": "#/$defs/sha256" },
        "adapter_basis_sha256": { "$ref": "#/$defs/sha256" },
        "frame_basis_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_digests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source_digest" }
    },
    "load_conservation": { "$ref": "#/$defs/load_conservation" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "sha256"],
      "properties": {
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "adapter_source_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "enum": [
            "bridge_evolution/creative_frame_adapter.py",
            "bridge_evolution/creative_shape.py",
            "bridge_evolution/frame_f1.py"
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tributary_length": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "tributary_length_m"],
      "properties": {
        "node_id": { "type": "string", "pattern": "^[AD][0-9]+$" },
        "tributary_length_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "load_conservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "line_load_kN_m",
        "deck_length_m",
        "expected_total_vertical_load_kN",
        "actual_total_vertical_load_kN",
        "relative_error",
        "relative_tolerance",
        "tributary_length_by_node_m"
      ],
      "properties": {
        "status": { "const": "PASS" },
        "line_load_kN_m": { "type": "number", "exclusiveMinimum": 0 },
        "deck_length_m": { "type": "number", "exclusiveMinimum": 0 },
        "expected_total_vertical_load_kN": { "type": "number", "exclusiveMinimum": 0 },
        "actual_total_vertical_load_kN": { "type": "number", "exclusiveMinimum": 0 },
        "relative_error": { "type": "number", "minimum": 0 },
        "relative_tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "tributary_length_by_node_m": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/tributary_length" }
        }
      }
    }
  }
}
