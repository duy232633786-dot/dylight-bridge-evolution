                  ]
                },
                {
                  "required": [
                    "steel_top_flange_thickness_mm"
                  ]
                },
                {
                  "required": [
                    "steel_top_flange_width_mm"
                  ]
                },
                {
                  "required": [
                    "steel_web_thickness_mm"
                  ]
                },
                {
                  "required": [
                    "top_flange_thickness_mm"
                  ]
