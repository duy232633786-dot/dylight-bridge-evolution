{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bridge_design_state.schema.json",
  "title": "BridgeDesignState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "family",
    "project_inputs",
    "design_variables",
    "materials",
    "analysis",
    "constraints"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^BT-(?:[0-9a-f]{8}|[0-9a-f]{16})$",
      "description": "ID 8 hex cũ được nhận ở input; output luôn tái sinh bằng hash 16 hex."
    },
    "family": {
      "enum": [
        "super_t_simple_v1",
        "super_t_parametric_v2",
        "i_girder_parametric_v1",
        "box_girder_parametric_v1",
        "composite_i_girder_parametric_v1"
      ],
      "description": "super_t_simple_v1 = tiết diện định hình tra catalog; super_t_parametric_v2 = Super-T tham số hoá (girder_catalog_id = ST-PARAM); i_girder / box_girder / composite_i = ba họ tiết diện của BRD-025. GIỮ dạng enum: đây là hàng rào có chủ ý duy nhất chặn các họ sandbox (ví dụ vòm) khỏi pipeline."
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "EVALUATED",
        "APPROVED",
        "REJECTED"
      ]
    },
    "project_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_length_m",
        "deck_width_m",
        "alignment_type",
        "skew_deg"
      ],
      "properties": {
        "span_length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "deck_width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "alignment_type": {
          "enum": [
            "STRAIGHT"
          ]
        },
        "skew_deg": {
          "type": "number"
        }
      }
    },
    "design_variables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "girder_catalog_id",
        "girder_count",
        "girder_spacing_mm",
        "deck_slab_thickness_mm",
        "diaphragm_layout_id",
        "prestress_layout_id"
      ],
      "properties": {
        "girder_catalog_id": {
          "type": "string"
        },
        "girder_count": {
          "type": "integer",
          "minimum": 1
        },
        "girder_spacing_mm": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "deck_slab_thickness_mm": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "diaphragm_layout_id": {
          "type": "string"
        },
        "prestress_layout_id": {
          "type": "string"
        },
        "girder_depth_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "H — chiều cao tiết diện. Chỉ dùng khi girder_catalog_id = ST-PARAM."
        },
        "top_flange_width_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "bf — bề rộng cánh trên (tham số hóa)."
        },
        "top_flange_thickness_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "tf — chiều dày cánh trên (tham số hóa)."
        },
        "web_thickness_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "tw — chiều dày MỖI sườn (tham số hóa)."
        },
        "bottom_bulb_width_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "bb — bề rộng MỖI bầu dưới (tham số hóa)."
        },
        "bottom_bulb_height_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "hb — chiều cao MỖI bầu dưới (tham số hóa)."
        },
        "bottom_flange_width_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "bf,bot — bề rộng cánh dưới (họ dầm I)."
        },
        "bottom_flange_thickness_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "tf,bot — chiều dày cánh dưới (họ dầm I)."
        },
        "box_web_height_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "chiều cao sườn hộp."
        },
        "box_web_thickness_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "chiều dày MỖI sườn hộp."
        },
        "box_bottom_width_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "bề rộng bản đáy hộp."
        },
        "box_bottom_slab_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "chiều dày bản đáy hộp."
        },
        "steel_depth_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "chiều cao dầm thép (họ liên hợp)."
        },
        "steel_top_flange_width_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "bề rộng cánh trên thép."
        },
        "steel_top_flange_thickness_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "chiều dày cánh trên thép."
        },
        "steel_web_thickness_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "chiều dày sườn thép."
        },
        "steel_bottom_flange_width_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "bề rộng cánh dưới thép."
        },
        "steel_bottom_flange_thickness_mm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "chiều dày cánh dưới thép."
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "girder_concrete_id",
        "deck_concrete_id",
        "prestressing_steel_id"
      ],
      "properties": {
        "girder_concrete_id": {
          "type": "string"
        },
        "deck_concrete_id": {
          "type": "string"
        },
        "prestressing_steel_id": {
          "type": "string"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fidelity",
        "solver",
        "load_profile_id"
      ],
      "properties": {
        "fidelity": {
          "enum": [
            "L1_LINE_GIRDER",
            "L2_GRILLAGE",
            "L3_NONLINEAR"
          ]
        },
        "solver": {
          "enum": [
            "BUILTIN_L1",
            "MIDAS_CIVIL",
            "OPENSEESPY"
          ]
        },
        "load_profile_id": {
          "type": "string"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_profile_id"
      ],
      "properties": {
        "rule_profile_id": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "random_seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "parent_candidate_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation_action": {
          "type": "string"
        },
        "bim_guid_map": {
          "type": "object"
        },
        "fe_element_map": {
          "type": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "family": {
            "const": "super_t_simple_v1"
          }
        },
        "required": [
          "family"
        ]
      },
      "then": {
        "properties": {
          "project_inputs": {
            "properties": {
              "span_length_m": {
                "const": 38.3
              },
              "deck_width_m": {
                "const": 12.0
              },
              "alignment_type": {
                "const": "STRAIGHT"
              },
              "skew_deg": {
                "const": 0
              }
            }
          },
          "design_variables": {
            "properties": {
              "girder_count": {
                "minimum": 2
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "bottom_bulb_height_mm"
                  ]
                },
                {
                  "required": [
                    "bottom_bulb_width_mm"
                  ]
                },
                {
                  "required": [
                    "bottom_flange_thickness_mm"
                  ]
                },
                {
                  "required": [
                    "bottom_flange_width_mm"
                  ]
                },
                {
                  "required": [
                    "box_bottom_slab_mm"
                  ]
                },
                {
                  "required": [
                    "box_bottom_width_mm"
                  ]
                },
                {
                  "required": [
                    "box_web_height_mm"
                  ]
