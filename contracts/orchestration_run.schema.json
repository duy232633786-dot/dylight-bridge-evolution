{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestration_run.schema.json",
  "title": "BridgeLabOrchestrationRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "brief_id", "created_at", "updated_at",
    "status", "planner", "task_ids", "provider_policy", "attempts",
    "events", "human_gate", "knowledge_sync"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{8}-[a-f0-9]{8}$"},
    "brief_id": {"type": "string", "pattern": "^RND-[0-9]{8}-[a-f0-9]{8}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "status": {
      "enum": [
        "PLANNED", "RUNNING", "WAITING_FOR_PROVIDER", "WAITING_FOR_REVIEW",
        "WAITING_FOR_HUMAN", "DIGITAL_COMPLETE", "FAILED", "CANCELLED"
      ]
    },
    "planner": {"type": "string", "minLength": 2},
    "task_ids": {
      "type": "array", "minItems": 4, "maxItems": 12, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^RND-[a-f0-9]{8}-[0-9]{2}$"}
    },
    "provider_policy": {"enum": ["STRICT_MULTI_VENDOR", "AVAILABLE_WITH_FALLBACK"]},
    "attempts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 6}
    },
    "recovery_grants": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 2}
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["at", "kind", "message"],
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "kind": {"type": "string", "minLength": 2},
          "message": {"type": "string", "minLength": 2},
          "task_id": {"type": "string"},
          "provider": {"type": "string"}
        }
      }
    },
    "human_gate": {"type": ["string", "null"]},
    "knowledge_sync": {"enum": ["PENDING", "SYNCED", "CONFLICT"]}
  }
}
