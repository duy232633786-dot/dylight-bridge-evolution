{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task_contract_amendment.schema.json",
  "title": "BridgeLabTaskContractAmendment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "amendment_id", "amendment_sha256", "created_at",
    "task_id", "authorized_by", "reason", "pre_task_sha256",
    "post_task_sha256", "previous_amendment_sha256", "snapshot", "changes",
    "previous_status", "next_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "amendment_id": {"type": "string", "pattern": "^AMD-[a-f0-9]{16}$"},
    "amendment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "task_id": {
      "type": "string",
      "pattern": "^(BRD-[0-9]{3}|RND-[a-f0-9]{8}-[0-9]{2})$"
    },
    "authorized_by": {"type": "string", "minLength": 2, "maxLength": 64},
    "reason": {"type": "string", "minLength": 5, "maxLength": 2000},
    "pre_task_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "post_task_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "previous_amendment_sha256": {
      "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^multiagent/task_contract_snapshots/sha256/[a-f0-9]{64}\\.json$"
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "changes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["field", "before", "after"],
        "properties": {
          "field": {
            "enum": [
              "title", "research_question", "required_gates", "claim_ceiling",
              "acceptance_criteria", "safety_notes", "human_gate", "status"
            ]
          },
          "before": {},
          "after": {}
        }
      }
    },
    "previous_status": {
      "enum": ["BACKLOG", "READY", "ACTIVE", "REVIEW", "BLOCKED", "ACCEPTED", "REJECTED"]
    },
    "next_status": {
      "enum": ["BACKLOG", "READY", "ACTIVE", "REVIEW", "BLOCKED", "ACCEPTED", "REJECTED"]
    },
    "run_id": {
      "type": "string", "pattern": "^RUN-[0-9]{8}-[a-f0-9]{8}$"
    }
  }
}
