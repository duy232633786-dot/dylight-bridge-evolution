{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation_result.schema.json",
  "title": "EvaluationResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "status", "feasible", "solver", "violations", "provenance"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^BT-[0-9a-f]{16}$" },
    "status": { "enum": ["SUCCESS", "SCHEMA_INVALID", "GEOMETRY_INVALID", "SOLVER_FAILED"] },
    "feasible": { "type": "boolean" },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["CONVERGED", "NOT_CONVERGED", "NOT_RUN"] },
        "name": { "type": "string" },
        "runtime_ms": { "type": "number", "minimum": 0 }
      }
    },
    "responses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Mu_strength1_kNm": { "type": "number" },
        "phiMn_kNm": { "type": "number" },
        "Vu_strength1_kN": { "type": "number" },
        "phiVn_kN": { "type": "number" },
        "bottom_stress_service3_MPa": { "type": "number" },
        "tension_limit_MPa": { "type": "number" },
        "max_ll_deflection_mm": { "type": "number" },
        "deflection_limit_mm": { "type": "number" },
        "first_frequency_Hz": { "type": "number" },
        "max_utilization": { "type": "number" },
        "distribution_factor_moment": { "type": "number" },
        "distribution_factor_shear": { "type": "number" }
      }
    },
    "objectives": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relative_cost": { "type": "number" },
        "material_mass_t": { "type": "number" },
        "embodied_carbon_kgCO2e": { "type": "number" }
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "severity", "message", "margin"],
        "properties": {
          "rule_id": { "type": "string" },
          "severity": { "enum": ["HARD", "SOFT"] },
          "message": { "type": "string" },
          "margin": { "type": "number", "description": "Mức vi phạm chuẩn hóa: (demand-capacity)/capacity, > 0 nghĩa là FAIL" }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_state", "verification_report"],
      "properties": {
        "design_state": { "type": "string" },
        "analysis_result": { "type": "string" },
        "verification_report": { "type": "string" }
      }
    },
    "component_audit": { "$ref": "#/$defs/component_audit" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_hash", "ruleset_version", "solver_version", "catalogs_version"],
      "properties": {
        "input_hash": { "type": "string" },
        "ruleset_version": { "type": "string" },
        "solver_version": { "type": "string" },
        "catalogs_version": { "type": "string" },
        "grammar_version": { "type": "string" },
        "random_seed": { "type": ["integer", "null"] },
        "timestamp_utc": { "type": "string" }
      }
    }
  },
  "$defs": {
    "component_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_version", "candidate_id", "candidate_input_hash",
        "parent_candidate_id", "status", "verdict_authority",
        "alters_evaluation_verdict", "components", "blocking_reasons",
        "proposals", "hash_algorithm", "audit_hash"
      ],
      "properties": {
        "registry_version": { "type": "string", "pattern": "^component-audit/[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "candidate_id": { "type": "string", "pattern": "^BT-[0-9a-f]{16}$" },
        "candidate_input_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "parent_candidate_id": { "type": ["string", "null"], "minLength": 1 },
        "status": { "enum": ["SCREENED", "BLOCKED", "REJECTED"] },
        "verdict_authority": { "const": "INDEPENDENT_VERIFIER" },
        "alters_evaluation_verdict": { "const": false },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/component_result" }
        },
        "blocking_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocking_reason" }
        },
        "proposals": {
          "type": "array",
          "items": { "$ref": "#/$defs/repair_proposal" }
        },
        "hash_algorithm": { "const": "SHA-256" },
        "audit_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "component_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "kind", "registry_supported", "checks"],
      "properties": {
        "component_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,95}$" },
        "registry_supported": { "type": "boolean" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component_check" }
        }
      }
    },
    "component_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id", "status", "severity", "evidence", "message",
        "rationale", "utilization"
      ],
      "properties": {
        "check_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,95}$" },
        "status": { "enum": ["PASS", "FAIL", "NOT_EVALUATED", "NOT_APPLICABLE"] },
        "severity": { "enum": ["HARD", "SOFT"] },
        "evidence": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/check_evidence" }
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "rationale": { "type": ["string", "null"], "minLength": 1 },
        "utilization": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "check_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "sha256", "fidelity", "producer"],
      "properties": {
        "source_ref": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "fidelity": {
          "enum": ["L0", "L1", "L2", "L3", "EXTERNAL_SOLVER", "PHYSICAL", "ENGINEER_REVIEW"]
        },
        "producer": { "type": "string", "minLength": 1 },
        "generated_at_utc": { "type": "string", "minLength": 1 }
      }
    },
    "blocking_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "component_id", "check_id", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$" },
        "component_id": { "type": ["string", "null"], "minLength": 1 },
        "check_id": { "type": ["string", "null"], "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "repair_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id", "component_id", "check_id", "kind", "action",
        "expected_direction", "tradeoffs", "required_evidence",
        "requires_reanalysis", "claim"
      ],
      "properties": {
        "proposal_id": { "type": "string", "pattern": "^RP-[0-9a-f]{12}$" },
        "component_id": { "type": "string", "minLength": 1 },
        "check_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["REPAIR", "EVIDENCE_REQUEST"] },
        "action": { "type": "string", "minLength": 1 },
        "expected_direction": { "type": "string", "minLength": 1 },
        "tradeoffs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "requires_reanalysis": { "const": true },
        "claim": { "const": "UNVERIFIED_PROPOSAL" }
      }
    }
  }
}
